#!/usr/bin/env bash
# shellcheck shell=bash
#
# repro-sources-list - Pin Ubuntu or Debian APT sources to a snapshot.

set -Eeuo pipefail

readonly PROGRAM_NAME="repro-sources-list"
readonly VERSION="2.0.0"

TIMESTAMP=""
ROOT="/"
DISTRO=""
CODENAME=""
SOURCE_FORMAT="auto"
EXECUTE=false
ASSUME_YES=false
VERBOSE=false
WORKSPACE=""
BACKUP_DIR=""
TRANSACTION_ACTIVE=false

declare -a ACTIVE_SOURCE_FILES=()
declare -a OUTPUT_RELATIVE_PATHS=()
declare -a OUTPUT_STAGED_FILES=()
declare -a BACKED_UP_ORIGINALS=()
declare -a BACKED_UP_FILES=()
declare -a WRITTEN_PATHS=()

# @description Print command help, safety behavior, and exits.
usage() {
  cat <<'EOF'
Usage:
  repro-sources-list TIMESTAMP [options]

Generate and optionally apply an APT source configuration pinned to one Ubuntu
or Debian snapshot. Preview is the default; /etc is changed only with --execute.

Arguments:
  TIMESTAMP           UTC snapshot ID in YYYYMMDDTHHMMSSZ form

Options:
  --execute           Apply the displayed transaction
  --yes               Skip typed confirmation; requires --execute
  --root DIRECTORY    Configure an alternate root or chroot (default: /)
  --distro NAME       Override detected distro: ubuntu or debian
  --codename NAME     Override the detected release codename
  --format FORMAT     Ubuntu source format: auto, deb822, or legacy
  --verbose           Show transaction details
  -h, --help          Show help
  -v, --version       Show version

Behavior:
  Ubuntu Deb822 output uses Canonical's Snapshot: field. Legacy Ubuntu output
  uses the snapshot= source option. Debian output uses snapshot.debian.org and
  disables Valid-Until checks only for the pinned snapshot entries.

  Applying the plan moves every active *.list and *.sources file, plus the main
  sources.list when present, into a private backup below:

      /var/backups/repro-sources-list/

  It then publishes the generated configuration atomically. A failed apply is
  rolled back. The command never runs apt update and never performs a network
  request, so the selected snapshot's availability is validated later by APT.

Examples:
  repro-sources-list 20260801T000000Z
  sudo repro-sources-list 20260801T000000Z --execute
  repro-sources-list 20260801T000000Z --root ./rootfs --execute --yes
  repro-sources-list 20260801T000000Z --distro ubuntu --codename noble --format deb822

Exit codes:
  0   Preview or apply completed
  1   Transaction or rollback failure
  64  Invalid command-line usage
  69  Unsupported or incomplete operating-system metadata
  77  Execution permission or confirmation failure
  127 Missing required system command
EOF
}

# @description Print an informational diagnostic.
# @arg $@ string Message.
log() {
  printf '%s: %s\n' "${PROGRAM_NAME}" "$*" >&2
}

# @description Print a verbose diagnostic.
# @arg $@ string Message.
debug() {
  if [[ ${VERBOSE} == true ]]; then
    printf '%s: debug: %s\n' "${PROGRAM_NAME}" "$*" >&2
  fi
}

# @description Print an error and exit with a requested status.
# @arg $1 integer Exit status.
# @arg $@ string Error message.
die() {
  local status="$1"
  shift
  printf '%s: error: %s\n' "${PROGRAM_NAME}" "$*" >&2
  exit "${status}"
}

# @description Require a command to exist on PATH.
# @arg $1 string Command name.
require_command() {
  command -v "$1" >/dev/null 2>&1 || die 127 "missing required command: $1"
}

# @description Require a nonempty value after an option.
# @arg $1 string Option name.
# @arg $2 integer Remaining argument count.
# @arg $3 string Candidate value.
require_option_value() {
  if (($2 < 2)) || [[ -z ${3:-} ]]; then
    die 64 "$1 requires a nonempty value"
  fi
}

# @description Parse CLI arguments into configuration globals.
# @arg $@ string CLI arguments.
parse_arguments() {
  while (($# > 0)); do
    case "$1" in
      --execute)
        EXECUTE=true
        shift
        ;;
      --yes)
        ASSUME_YES=true
        shift
        ;;
      --root | --distro | --codename | --format)
        require_option_value "$1" "$#" "${2:-}"
        case "$1" in
          --root) ROOT="$2" ;;
          --distro) DISTRO="$2" ;;
          --codename) CODENAME="$2" ;;
          --format) SOURCE_FORMAT="$2" ;;
        esac
        shift 2
        ;;
      --verbose)
        VERBOSE=true
        shift
        ;;
      -h | --help)
        usage
        exit 0
        ;;
      -v | --version)
        printf '%s %s\n' "${PROGRAM_NAME}" "${VERSION}"
        exit 0
        ;;
      --)
        shift
        while (($# > 0)); do
          [[ -z ${TIMESTAMP} ]] || die 64 "only one timestamp may be supplied"
          TIMESTAMP="$1"
          shift
        done
        ;;
      -*) die 64 "unknown option: $1" ;;
      *)
        [[ -z ${TIMESTAMP} ]] || die 64 "unexpected argument: $1"
        TIMESTAMP="$1"
        shift
        ;;
    esac
  done
}

# @description Return a path beneath the configured root.
# @arg $1 string Absolute target path inside the root.
root_path() {
  local path="$1"
  if [[ ${ROOT} == / ]]; then
    printf '%s\n' "${path}"
  else
    printf '%s%s\n' "${ROOT}" "${path}"
  fi
}

# @description Read one literal key from os-release without executing it.
# @arg $1 string Metadata key.
read_os_release_value() {
  local key="$1"
  local os_release
  os_release="$(root_path /etc/os-release)"
  awk -F= -v expected="${key}" '
    $1 == expected {
      value = substr($0, index($0, "=") + 1)
      if (value ~ /^".*"$/ || value ~ /^\047.*\047$/) {
        value = substr(value, 2, length(value) - 2)
      }
      print value
      exit
    }
  ' "${os_release}"
}

# @description Validate CLI configuration and detect missing OS metadata.
validate_configuration() {
  local canonical_root os_release
  [[ -n ${TIMESTAMP} ]] || die 64 "a snapshot timestamp is required"
  [[ ${TIMESTAMP} =~ ^[0-9]{4}(0[1-9]|1[0-2])(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3])[0-5][0-9][0-5][0-9]Z$ ]] ||
    die 64 "timestamp must use YYYYMMDDTHHMMSSZ format"
  case "${SOURCE_FORMAT}" in
    auto | deb822 | legacy) ;;
    *) die 64 "--format must be auto, deb822, or legacy" ;;
  esac
  [[ -d ${ROOT} ]] || die 69 "root directory does not exist: ${ROOT}"
  canonical_root="$(cd "${ROOT}" && pwd -P)" || die 69 "could not resolve root: ${ROOT}"
  ROOT="${canonical_root}"
  os_release="$(root_path /etc/os-release)"

  if [[ -z ${DISTRO} || -z ${CODENAME} ]]; then
    [[ -r ${os_release} ]] || die 69 "cannot read operating-system metadata: ${os_release}"
  fi
  [[ -n ${DISTRO} ]] || DISTRO="$(read_os_release_value ID)"
  [[ -n ${CODENAME} ]] || CODENAME="$(read_os_release_value VERSION_CODENAME)"
  [[ -n ${CODENAME} ]] || CODENAME="$(read_os_release_value UBUNTU_CODENAME)"

  case "${DISTRO}" in
    ubuntu | debian) ;;
    *) die 69 "unsupported distribution: ${DISTRO:-unknown}" ;;
  esac
  if [[ ${DISTRO} == ubuntu && ${TIMESTAMP%%T*} -lt 20230301 ]]; then
    die 64 "Ubuntu snapshots are unavailable before 20230301"
  fi
  [[ ${CODENAME} =~ ^[a-z0-9][a-z0-9._-]*$ ]] ||
    die 69 "invalid or missing release codename: ${CODENAME:-unknown}"
  if [[ ${DISTRO} == debian && ${SOURCE_FORMAT} == deb822 ]]; then
    die 64 "--format deb822 is currently supported only for Ubuntu"
  fi
  if [[ ${ASSUME_YES} == true && ${EXECUTE} == false ]]; then
    die 64 "--yes requires --execute"
  fi
  if [[ ${EXECUTE} == true && ${ROOT} == / && ${EUID} -ne 0 ]]; then
    die 77 "applying the host configuration requires root; rerun with sudo"
  fi

  for command_name in awk basename cat chmod cp date dirname find ln mkdir mktemp mv pwd rm; do
    require_command "${command_name}"
  done
}

# @description Create the private generation workspace.
create_workspace() {
  WORKSPACE="$(mktemp -d "${TMPDIR:-/tmp}/${PROGRAM_NAME}.XXXXXX")" ||
    die 1 "could not create a temporary workspace"
}

# @description Remove temporary files after preview or apply.
cleanup_workspace() {
  if [[ -n ${WORKSPACE} && -d ${WORKSPACE} ]]; then
    rm -rf "${WORKSPACE}"
  fi
}

# @description Add one generated output to the publication plan.
# @arg $1 string Absolute path relative to the configured root.
# @arg $2 string Staged content file.
add_output() {
  OUTPUT_RELATIVE_PATHS+=("$1")
  OUTPUT_STAGED_FILES+=("$2")
}

# @description Generate the Ubuntu Deb822 snapshot configuration.
generate_ubuntu_deb822() {
  local source_file="${WORKSPACE}/ubuntu.sources"
  local legacy_file="${WORKSPACE}/sources.list"
  cat >"${source_file}" <<EOF
# Generated by ${PROGRAM_NAME} ${VERSION}.
Types: deb
URIs: http://archive.ubuntu.com/ubuntu
Suites: ${CODENAME} ${CODENAME}-updates
Components: main restricted universe multiverse
Signed-By: /usr/share/keyrings/ubuntu-archive-keyring.gpg
Snapshot: ${TIMESTAMP}

Types: deb
URIs: http://security.ubuntu.com/ubuntu
Suites: ${CODENAME}-security
Components: main restricted universe multiverse
Signed-By: /usr/share/keyrings/ubuntu-archive-keyring.gpg
Snapshot: ${TIMESTAMP}
EOF
  printf '# Managed by %s through sources.list.d/ubuntu.sources.\n' "${PROGRAM_NAME}" >"${legacy_file}"
  add_output "/etc/apt/sources.list" "${legacy_file}"
  add_output "/etc/apt/sources.list.d/ubuntu.sources" "${source_file}"
}

# @description Generate the legacy Ubuntu snapshot configuration.
generate_ubuntu_legacy() {
  local source_file="${WORKSPACE}/sources.list"
  cat >"${source_file}" <<EOF
# Generated by ${PROGRAM_NAME} ${VERSION}.
deb [snapshot=${TIMESTAMP}] http://archive.ubuntu.com/ubuntu/ ${CODENAME} main restricted universe multiverse
deb [snapshot=${TIMESTAMP}] http://archive.ubuntu.com/ubuntu/ ${CODENAME}-updates main restricted universe multiverse
deb [snapshot=${TIMESTAMP}] http://security.ubuntu.com/ubuntu/ ${CODENAME}-security main restricted universe multiverse
EOF
  add_output "/etc/apt/sources.list" "${source_file}"
}

# @description Generate the Debian snapshot configuration.
generate_debian_legacy() {
  local source_file="${WORKSPACE}/sources.list"
  cat >"${source_file}" <<EOF
# Generated by ${PROGRAM_NAME} ${VERSION}.
deb [check-valid-until=no] https://snapshot.debian.org/archive/debian/${TIMESTAMP}/ ${CODENAME} main
deb [check-valid-until=no] https://snapshot.debian.org/archive/debian/${TIMESTAMP}/ ${CODENAME}-updates main
deb [check-valid-until=no] https://snapshot.debian.org/archive/debian-security/${TIMESTAMP}/ ${CODENAME}-security main
EOF
  add_output "/etc/apt/sources.list" "${source_file}"
}

# @description Select a source format and generate staged outputs.
generate_configuration() {
  if [[ ${DISTRO} == ubuntu ]]; then
    if [[ ${SOURCE_FORMAT} == auto ]]; then
      if [[ -f "$(root_path /etc/apt/sources.list.d/ubuntu.sources)" ]]; then
        SOURCE_FORMAT="deb822"
      else
        SOURCE_FORMAT="legacy"
      fi
    fi
    case "${SOURCE_FORMAT}" in
      deb822) generate_ubuntu_deb822 ;;
      legacy) generate_ubuntu_legacy ;;
    esac
  else
    SOURCE_FORMAT="legacy"
    generate_debian_legacy
  fi
}

# @description Inventory every active APT source file that will be backed up.
collect_active_sources() {
  local file source_directory main_file
  main_file="$(root_path /etc/apt/sources.list)"
  source_directory="$(root_path /etc/apt/sources.list.d)"
  if [[ -e ${main_file} || -L ${main_file} ]]; then
    ACTIVE_SOURCE_FILES+=("${main_file}")
  fi
  if [[ -d ${source_directory} ]]; then
    shopt -s nullglob
    for file in "${source_directory}"/*.list "${source_directory}"/*.sources; do
      ACTIVE_SOURCE_FILES+=("${file}")
    done
    shopt -u nullglob
  fi
}

# @description Return a configured-root-relative path for reporting and backup.
# @arg $1 string Absolute host path.
relative_to_root() {
  local path="$1"
  if [[ ${ROOT} == / ]]; then
    printf '%s\n' "${path#/}"
  else
    printf '%s\n' "${path#"${ROOT}"/}"
  fi
}

# @description Print the complete deterministic mutation plan.
print_plan() {
  local index relative
  printf 'MODE\t%s\n' "$([[ ${EXECUTE} == true ]] && printf execute || printf preview)"
  printf 'ROOT\t%s\n' "${ROOT}"
  printf 'DISTRO\t%s\n' "${DISTRO}"
  printf 'CODENAME\t%s\n' "${CODENAME}"
  printf 'TIMESTAMP\t%s\n' "${TIMESTAMP}"
  printf 'FORMAT\t%s\n' "${SOURCE_FORMAT}"
  for path in "${ACTIVE_SOURCE_FILES[@]}"; do
    printf 'BACKUP\t/%s\n' "$(relative_to_root "${path}")"
  done
  for ((index = 0; index < ${#OUTPUT_RELATIVE_PATHS[@]}; index += 1)); do
    relative="${OUTPUT_RELATIVE_PATHS[index]}"
    printf '\nWRITE\t%s\n' "${relative}"
    cat "${OUTPUT_STAGED_FILES[index]}"
  done
}

# @description Require typed confirmation before host mutation.
confirm_execution() {
  local answer
  [[ ${EXECUTE} == true && ${ASSUME_YES} == false ]] || return 0
  if [[ ! -t 0 ]]; then
    die 77 "confirmation requires a terminal; use --yes for unattended execution"
  fi
  printf 'Type %s to replace the active APT sources: ' "${TIMESTAMP}" >&2
  IFS= read -r answer || answer=""
  [[ ${answer} == "${TIMESTAMP}" ]] || die 77 "confirmation did not match; no files were changed"
}

# @description Restore moved sources after a failed transaction.
rollback_transaction() {
  local index original backup
  [[ ${TRANSACTION_ACTIVE} == true ]] || return 0
  log "rolling back the incomplete APT source transaction"
  for path in "${WRITTEN_PATHS[@]}"; do
    rm -f "${path}" || true
  done
  for ((index = ${#BACKED_UP_ORIGINALS[@]} - 1; index >= 0; index -= 1)); do
    original="${BACKED_UP_ORIGINALS[index]}"
    backup="${BACKED_UP_FILES[index]}"
    mkdir -p "$(dirname "${original}")" || true
    if [[ ! -e ${original} && ! -L ${original} ]]; then
      mv "${backup}" "${original}" || true
    else
      log "rollback could not restore occupied path: ${original}; backup remains at ${backup}"
    fi
  done
  TRANSACTION_ACTIVE=false
}

# @description Handle an unexpected transaction error and preserve its status.
handle_error() {
  local status=$?
  rollback_transaction
  exit "${status}"
}

# @description Apply the generated configuration as a recoverable transaction.
apply_configuration() {
  local run_id backup_parent relative backup original index destination staged temporary
  [[ ${EXECUTE} == true ]] || {
    log "preview only; rerun with --execute to apply this plan"
    return 0
  }

  run_id="$(date -u '+%Y%m%dT%H%M%SZ')-$$"
  BACKUP_DIR="$(root_path "/var/backups/${PROGRAM_NAME}/${run_id}")"
  backup_parent="$(dirname "${BACKUP_DIR}")"
  mkdir -p "${backup_parent}" || die 1 "could not create backup parent: ${backup_parent}"
  mkdir -m 0700 "${BACKUP_DIR}" || die 1 "backup directory already exists or could not be created: ${BACKUP_DIR}"
  TRANSACTION_ACTIVE=true
  trap handle_error ERR

  for original in "${ACTIVE_SOURCE_FILES[@]}"; do
    relative="$(relative_to_root "${original}")"
    backup="${BACKUP_DIR}/${relative}"
    mkdir -p "$(dirname "${backup}")"
    debug "moving ${original} to ${backup}"
    mv "${original}" "${backup}"
    BACKED_UP_ORIGINALS+=("${original}")
    BACKED_UP_FILES+=("${backup}")
  done

  for ((index = 0; index < ${#OUTPUT_RELATIVE_PATHS[@]}; index += 1)); do
    destination="$(root_path "${OUTPUT_RELATIVE_PATHS[index]}")"
    staged="${OUTPUT_STAGED_FILES[index]}"
    mkdir -p "$(dirname "${destination}")"
    temporary="$(mktemp "$(dirname "${destination}")/.${PROGRAM_NAME}.XXXXXX")"
    cp "${staged}" "${temporary}"
    chmod 0644 "${temporary}"
    if ! ln "${temporary}" "${destination}" 2>/dev/null; then
      rm -f "${temporary}"
      printf '%s: error: destination appeared during publication: %s\n' \
        "${PROGRAM_NAME}" "${destination}" >&2
      return 1
    fi
    rm -f "${temporary}"
    WRITTEN_PATHS+=("${destination}")
  done

  TRANSACTION_ACTIVE=false
  trap - ERR
  log "APT sources pinned to ${TIMESTAMP}"
  log "previous sources saved under ${BACKUP_DIR}"
}

# @description Run the repro-sources-list command-line application.
# @arg $@ string CLI arguments.
main() {
  parse_arguments "$@"
  validate_configuration
  create_workspace
  trap cleanup_workspace EXIT
  trap 'rollback_transaction; exit 130' INT
  trap 'rollback_transaction; exit 143' TERM
  generate_configuration
  collect_active_sources
  print_plan
  confirm_execution
  apply_configuration
}

main "$@"
