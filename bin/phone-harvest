#!/usr/bin/env bash
# shellcheck disable=SC2088 # Quoted tildes are expanded on the remote Termux host.

# ==============================================================================
# phone-harvest
# ==============================================================================
#
# Safely copy or move files from an Android/Termux device over SSH.
#
# The default operation is intentionally non-destructive:
#
#   phone-harvest
#
# This copies every accessible file from the phone's shared storage into a
# source-preserving local archive. Source deletion requires an explicit --move.
#
# Compatible with Bash 3.2+ (including the Bash shipped with macOS).
#
# ==============================================================================

set -o errexit
set -o nounset
set -o pipefail

readonly PROGRAM_NAME="${0##*/}"
readonly PROGRAM_VERSION="2.1.0"

# ------------------------------------------------------------------------------
# Defaults
# ------------------------------------------------------------------------------

REMOTE_HOST="${PHONE_HARVEST_HOST:-termux}"
DESTINATION_ROOT="${PHONE_HARVEST_DESTINATION:-${HOME}/Downloads/phone}"
SOURCES_FILE="${PHONE_HARVEST_SOURCES_FILE:-${XDG_CONFIG_HOME:-${HOME}/.config}/phone-harvest/sources.conf}"

MODE="full"
MODE_WAS_EXPLICIT=false
TRANSFER_MODE="copy"
DRY_RUN=false
ASSUME_YES=false
NON_INTERACTIVE=false
CLEANUP_EMPTY_DIRECTORIES=false
USE_DEFAULT_SOURCES=true
SKIP_MISSING_SOURCES=true
ENABLE_PROGRESS="auto"
ENABLE_COLOR="auto"
CHECKSUM_MODE="auto"
VERBOSE=false
COMMAND="harvest"
COMMAND_WAS_EXPLICIT=false
INCLUDE_RESTRICTED_ANDROID_PATHS=false

SSH_PORT=""
SSH_IDENTITY_FILE=""
CONNECT_TIMEOUT=10
RUN_STARTED_AT="$(date +%s)"
RUN_ID="$(date "+%Y%m%d-%H%M%S")-$$"

SELECT_IMAGES=false
SELECT_VIDEOS=false
SELECT_AUDIO=false
SELECT_DOCUMENTS=false
EXCLUDE_IMAGES=false
EXCLUDE_VIDEOS=false
EXCLUDE_AUDIO=false
EXCLUDE_DOCUMENTS=false

declare -a SOURCE_TARGETS=()
declare -a SOURCE_PATHS=()
declare -a SOURCE_MODES=()
declare -a EXTRA_EXCLUDES=()
declare -a RSYNC_ARGS=()
declare -a SSH_ARGS=()

TRANSFERRED_SOURCES=0
SKIPPED_SOURCES=0
FAILED_SOURCES=0
FIRST_FAILURE_CODE=0
LAST_SOURCE_WAS_SKIPPED=false

# ------------------------------------------------------------------------------
# Output
# ------------------------------------------------------------------------------

COLOR_RESET=""
COLOR_RED=""
COLOR_GREEN=""
COLOR_YELLOW=""
COLOR_BLUE=""
COLOR_CYAN=""
COLOR_BOLD=""

# @description Configure color sequences for the selected output mode.
configure_output() {
  local use_color=false

  case "${ENABLE_COLOR}" in
    always)
      use_color=true
      ;;
    auto)
      if [[ -t 1 && -z ${NO_COLOR:-} && ${TERM:-dumb} != "dumb" ]]; then
        use_color=true
      fi
      ;;
    never)
      ;;
  esac

  if [[ ${use_color} == true ]]; then
    COLOR_RESET=$'\033[0m'
    COLOR_RED=$'\033[31m'
    COLOR_GREEN=$'\033[32m'
    COLOR_YELLOW=$'\033[33m'
    COLOR_BLUE=$'\033[34m'
    COLOR_CYAN=$'\033[36m'
    COLOR_BOLD=$'\033[1m'
  fi
}

# @description Print an informational message.
# @arg $@ string Message.
log_info() {
  printf "%sℹ%s %s\n" "${COLOR_BLUE}" "${COLOR_RESET}" "$*"
}

# @description Print a success message.
# @arg $@ string Message.
log_success() {
  printf "%s✓%s %s\n" "${COLOR_GREEN}" "${COLOR_RESET}" "$*"
}

# @description Print a warning to standard error.
# @arg $@ string Message.
log_warn() {
  printf "%s⚠%s %s\n" "${COLOR_YELLOW}" "${COLOR_RESET}" "$*" >&2
}

# @description Print an error to standard error.
# @arg $@ string Message.
log_error() {
  printf "%s✗%s %s\n" "${COLOR_RED}" "${COLOR_RESET}" "$*" >&2
}

# @description Print a diagnostic only when verbose mode is enabled.
# @arg $@ string Message.
log_debug() {
  if [[ ${VERBOSE} == true ]]; then
    printf "%s·%s %s\n" "${COLOR_CYAN}" "${COLOR_RESET}" "$*"
  fi
}

# @description Print an error and exit with a failure status.
# @arg $@ string Error message.
die() {
  log_error "$*"
  exit 1
}

# ------------------------------------------------------------------------------
# Help
# ------------------------------------------------------------------------------

# @description Print command help and transfer-safety guidance.
print_help() {
  cat <<EOF
${PROGRAM_NAME} ${PROGRAM_VERSION}

Safely copy or move files from an Android/Termux device over SSH.

USAGE
    ${PROGRAM_NAME} [COMMAND] [OPTIONS]

COMMANDS
    full            Pull all configured full-storage roots (default).
    categories      Pull all image, video, audio, and document categories.
    images          Pull recognized image files.
    videos          Pull recognized video files.
    audio           Pull recognized audio files.
    documents       Pull recognized document, ebook, data, and archive files.
    doctor          Validate local tools, SSH, rsync, and configured sources.
    sources         List the effective source configuration.

    Category commands may be combined:

        ${PROGRAM_NAME} images videos

TRANSFER SAFETY
    --copy                  Copy files and retain them on the phone (default).
    --move                  Remove each phone file only after rsync confirms it.
    --cleanup-empty-dirs    After --move, remove empty remote subdirectories.
    --yes                   Confirm destructive behavior without prompting.
    --dry-run               Preview transfers without copying or deleting files.
    --checksum              Compare existing files by checksum, not size/time.
    --no-checksum           Use rsync's faster size/time comparison.

CONNECTION AND DESTINATION
    --host HOST             SSH host or SSH config alias (default: ${REMOTE_HOST}).
    --destination PATH      Local archive root (default: ${DESTINATION_ROOT}).
    --port PORT             Override the SSH port.
    --identity FILE         SSH private-key file.
    --connect-timeout SEC   SSH connection timeout (default: ${CONNECT_TIMEOUT}).
    --non-interactive       Disable SSH and confirmation prompts.

SOURCES
    --sources-file FILE     Read additional source definitions from FILE.
    --no-sources-file       Do not load the configured sources file.
    --no-default-sources    Use only sources supplied by the sources file or CLI.
    --source TARGET=PATH    Add an unfiltered source to a full pull. Repeatable.
    --exclude PATTERN       Add an rsync exclude pattern. Repeatable.
    --include-restricted    Attempt Android/data and Android/obb (often blocked).
    --strict-sources        Fail when a configured remote source is unavailable.

CATEGORY COMPATIBILITY
    --images                Select images.
    --videos                Select videos.
    --audio                 Select audio.
    --docs, --documents     Select documents.
    --exclude-images        Omit images from an all-category pull.
    --exclude-videos        Omit videos from an all-category pull.
    --exclude-audio         Omit audio from an all-category pull.
    --exclude-docs          Omit documents from an all-category pull.

OUTPUT
    --progress              Always show per-file rsync progress.
    --no-progress           Disable per-file rsync progress.
    --color MODE            Color mode: auto, always, or never.
    --verbose               Show source and command diagnostics.
    --version               Print the version.
    --help                  Show this help.

EXAMPLES
    # Safely copy all shared phone storage.
    ${PROGRAM_NAME}

    # Preview a complete pull.
    ${PROGRAM_NAME} full --dry-run

    # Pull selected categories without deleting phone files.
    ${PROGRAM_NAME} images videos

    # Free phone space after successfully transferring every shared file.
    ${PROGRAM_NAME} full --move --cleanup-empty-dirs

    # Add another storage root for this run.
    ${PROGRAM_NAME} full --source "sd-card=~/storage/external-1"

SOURCE FILE FORMAT
    One pipe-delimited source per line:

        TARGET|REMOTE_PATH|MODES

    MODES is a comma-separated list containing full, images, videos, audio,
    and/or documents. Blank lines and lines beginning with # are ignored.

        shared/Recordings|~/storage/shared/Recordings|audio
        sd-card|~/storage/external-1|full

ENVIRONMENT
    PHONE_HARVEST_HOST
    PHONE_HARVEST_DESTINATION
    PHONE_HARVEST_SOURCES_FILE
    NO_COLOR
EOF
}

# ------------------------------------------------------------------------------
# Argument parsing
# ------------------------------------------------------------------------------

# @description Return success when a value is a positive decimal integer.
# @arg $1 string Candidate value.
is_positive_integer() {
  [[ $1 =~ ^[1-9][0-9]*$ ]]
}

# @description Select one file category and normalize category mode.
# @arg $1 string Category name.
select_category() {
  local category="$1"

  if [[ ${MODE_WAS_EXPLICIT} == false ]]; then
    MODE="categories"
    MODE_WAS_EXPLICIT=true
  elif [[ ${MODE} != "categories" ]]; then
    die "Cannot combine '${MODE}' with category '${category}'."
  fi

  case "${category}" in
    images) SELECT_IMAGES=true ;;
    videos) SELECT_VIDEOS=true ;;
    audio) SELECT_AUDIO=true ;;
    documents) SELECT_DOCUMENTS=true ;;
  esac
}

# @description Exclude one file category from category mode.
# @arg $1 string Category name.
select_category_exclusion() {
  local category="$1"

  if [[ ${MODE_WAS_EXPLICIT} == false ]]; then
    MODE="categories"
    MODE_WAS_EXPLICIT=true
    SELECT_IMAGES=true
    SELECT_VIDEOS=true
    SELECT_AUDIO=true
    SELECT_DOCUMENTS=true
  elif [[ ${MODE} != "categories" ]]; then
    die "Cannot exclude '${category}' from a '${MODE}' pull."
  fi

  case "${category}" in
    images) EXCLUDE_IMAGES=true ;;
    videos) EXCLUDE_VIDEOS=true ;;
    audio) EXCLUDE_AUDIO=true ;;
    documents) EXCLUDE_DOCUMENTS=true ;;
  esac
}

# @description Require a nonempty value after an option.
# @arg $1 string Option name.
# @arg $2 string Candidate value.
require_option_value() {
  local option="$1"
  local value="${2:-}"

  if [[ -z ${value} || ${value} == --* ]]; then
    die "${option} requires a value."
  fi
}

# @description Parse CLI arguments into transfer configuration.
# @arg $@ string CLI arguments.
parse_args() {
  while [[ $# -gt 0 ]]; do
    case "$1" in
      full)
        if [[ ${MODE_WAS_EXPLICIT} == true && ${MODE} != "full" ]]; then
          die "Cannot combine 'full' with '${MODE}'."
        fi
        MODE="full"
        MODE_WAS_EXPLICIT=true
        ;;
      categories)
        if [[ ${MODE_WAS_EXPLICIT} == true && ${MODE} != "categories" ]]; then
          die "Cannot combine 'categories' with '${MODE}'."
        fi
        MODE="categories"
        MODE_WAS_EXPLICIT=true
        SELECT_IMAGES=true
        SELECT_VIDEOS=true
        SELECT_AUDIO=true
        SELECT_DOCUMENTS=true
        ;;
      images | videos | audio)
        select_category "$1"
        ;;
      documents | docs)
        select_category "documents"
        ;;
      doctor)
        [[ ${COMMAND_WAS_EXPLICIT} == false ]] ||
          die "Only one command may be supplied."
        COMMAND="doctor"
        COMMAND_WAS_EXPLICIT=true
        ;;
      sources)
        [[ ${COMMAND_WAS_EXPLICIT} == false ]] ||
          die "Only one command may be supplied."
        COMMAND="sources"
        COMMAND_WAS_EXPLICIT=true
        ;;
      --copy | --copy-only)
        TRANSFER_MODE="copy"
        ;;
      --move | --remove-source-files)
        TRANSFER_MODE="move"
        ;;
      --cleanup-empty-dirs)
        CLEANUP_EMPTY_DIRECTORIES=true
        ;;
      --no-cleanup)
        CLEANUP_EMPTY_DIRECTORIES=false
        ;;
      --yes)
        ASSUME_YES=true
        ;;
      --dry-run)
        DRY_RUN=true
        ;;
      --checksum)
        CHECKSUM_MODE="always"
        ;;
      --no-checksum)
        CHECKSUM_MODE="never"
        ;;
      --host)
        require_option_value "$1" "${2:-}"
        REMOTE_HOST="$2"
        shift
        ;;
      --host=*)
        REMOTE_HOST="${1#*=}"
        ;;
      --destination)
        require_option_value "$1" "${2:-}"
        DESTINATION_ROOT="$2"
        shift
        ;;
      --destination=*)
        DESTINATION_ROOT="${1#*=}"
        ;;
      --port)
        require_option_value "$1" "${2:-}"
        SSH_PORT="$2"
        shift
        ;;
      --port=*)
        SSH_PORT="${1#*=}"
        ;;
      --identity)
        require_option_value "$1" "${2:-}"
        SSH_IDENTITY_FILE="$2"
        shift
        ;;
      --identity=*)
        SSH_IDENTITY_FILE="${1#*=}"
        ;;
      --connect-timeout)
        require_option_value "$1" "${2:-}"
        CONNECT_TIMEOUT="$2"
        shift
        ;;
      --connect-timeout=*)
        CONNECT_TIMEOUT="${1#*=}"
        ;;
      --non-interactive)
        NON_INTERACTIVE=true
        ;;
      --sources-file)
        require_option_value "$1" "${2:-}"
        SOURCES_FILE="$2"
        shift
        ;;
      --sources-file=*)
        SOURCES_FILE="${1#*=}"
        ;;
      --no-sources-file)
        SOURCES_FILE=""
        ;;
      --no-default-sources)
        USE_DEFAULT_SOURCES=false
        ;;
      --source)
        require_option_value "$1" "${2:-}"
        add_cli_source "$2"
        shift
        ;;
      --source=*)
        add_cli_source "${1#*=}"
        ;;
      --exclude)
        require_option_value "$1" "${2:-}"
        EXTRA_EXCLUDES+=("$2")
        shift
        ;;
      --exclude=*)
        EXTRA_EXCLUDES+=("${1#*=}")
        ;;
      --include-restricted)
        INCLUDE_RESTRICTED_ANDROID_PATHS=true
        ;;
      --strict-sources)
        SKIP_MISSING_SOURCES=false
        ;;
      --images)
        select_category "images"
        ;;
      --videos)
        select_category "videos"
        ;;
      --audio)
        select_category "audio"
        ;;
      --docs | --documents)
        select_category "documents"
        ;;
      --exclude-images)
        select_category_exclusion "images"
        ;;
      --exclude-videos)
        select_category_exclusion "videos"
        ;;
      --exclude-audio)
        select_category_exclusion "audio"
        ;;
      --exclude-docs | --exclude-documents)
        select_category_exclusion "documents"
        ;;
      --progress)
        ENABLE_PROGRESS="always"
        ;;
      --no-progress)
        ENABLE_PROGRESS="never"
        ;;
      --color)
        require_option_value "$1" "${2:-}"
        ENABLE_COLOR="$2"
        shift
        ;;
      --color=*)
        ENABLE_COLOR="${1#*=}"
        ;;
      --verbose)
        VERBOSE=true
        ;;
      --version)
        printf "%s %s\n" "${PROGRAM_NAME}" "${PROGRAM_VERSION}"
        exit 0
        ;;
      --help | -h)
        print_help
        exit 0
        ;;
      --)
        shift
        if [[ $# -gt 0 ]]; then
          die "Unexpected positional argument: $1"
        fi
        break
        ;;
      -*)
        die "Unknown option: $1"
        ;;
      *)
        die "Unknown command: $1"
        ;;
    esac
    shift
  done
}

# @description Validate option values and incompatible combinations.
validate_options() {
  [[ -n ${REMOTE_HOST} ]] || die "--host must not be empty."
  [[ ${REMOTE_HOST} != -* ]] || die "--host must not begin with '-'."
  [[ ${REMOTE_HOST} != *[[:space:]]* ]] || die "--host must not contain whitespace."
  [[ -n ${DESTINATION_ROOT} ]] || die "--destination must not be empty."
  [[ ${DESTINATION_ROOT} != *[$'\n\r']* ]] ||
    die "--destination must not contain line breaks."

  case "${ENABLE_COLOR}" in
    auto | always | never) ;;
    *) die "--color must be auto, always, or never." ;;
  esac

  is_positive_integer "${CONNECT_TIMEOUT}" ||
    die "--connect-timeout must be a positive integer."

  if [[ -n ${SSH_PORT} ]]; then
    is_positive_integer "${SSH_PORT}" ||
      die "--port must be a positive integer."
    if ((SSH_PORT > 65535)); then
      die "--port must not exceed 65535."
    fi
  fi

  if [[ -n ${SSH_IDENTITY_FILE} && ! -f ${SSH_IDENTITY_FILE} ]]; then
    die "SSH identity file does not exist: ${SSH_IDENTITY_FILE}"
  fi

  if [[ ${CLEANUP_EMPTY_DIRECTORIES} == true && ${TRANSFER_MODE} != "move" ]]; then
    die "--cleanup-empty-dirs requires --move."
  fi

  if [[ ${MODE} == "full" ]] &&
    [[ ${EXCLUDE_IMAGES} == true || ${EXCLUDE_VIDEOS} == true ||
      ${EXCLUDE_AUDIO} == true || ${EXCLUDE_DOCUMENTS} == true ]]; then
    die "Category exclusions require a category pull, not a full pull."
  fi

  if [[ ${MODE} == "categories" ]]; then
    if [[ ${SELECT_IMAGES} == false && ${SELECT_VIDEOS} == false &&
      ${SELECT_AUDIO} == false && ${SELECT_DOCUMENTS} == false ]]; then
      SELECT_IMAGES=true
      SELECT_VIDEOS=true
      SELECT_AUDIO=true
      SELECT_DOCUMENTS=true
    fi

    [[ ${EXCLUDE_IMAGES} == false ]] || SELECT_IMAGES=false
    [[ ${EXCLUDE_VIDEOS} == false ]] || SELECT_VIDEOS=false
    [[ ${EXCLUDE_AUDIO} == false ]] || SELECT_AUDIO=false
    [[ ${EXCLUDE_DOCUMENTS} == false ]] || SELECT_DOCUMENTS=false

    if [[ ${SELECT_IMAGES} == false && ${SELECT_VIDEOS} == false &&
      ${SELECT_AUDIO} == false && ${SELECT_DOCUMENTS} == false ]]; then
      die "No categories remain selected."
    fi
  fi
}

# ------------------------------------------------------------------------------
# Source configuration
# ------------------------------------------------------------------------------

# @description Trim leading and trailing whitespace from a value.
# @arg $1 string Input value.
# @stdout Trimmed value.
trim() {
  local value="$1"
  value="${value#"${value%%[![:space:]]*}"}"
  value="${value%"${value##*[![:space:]]}"}"
  printf "%s" "${value}"
}

# @description Return success for a safe relative destination target.
# @arg $1 string Target path.
validate_target() {
  local target="$1"

  [[ -n ${target} ]] || return 1
  [[ ${target} != /* ]] || return 1
  [[ ${target} != "." && ${target} != ".." ]] || return 1
  [[ ${target} != ../* && ${target} != */../* && ${target} != */.. ]] || return 1
  [[ ${target} != *"|"* ]] || return 1
  [[ ${target} != *[$'\n\r\t']* ]] || return 1
}

# @description Validate and register one remote source definition.
# @arg $1 string Local relative target.
# @arg $2 string Remote source path.
# @arg $3 string Comma-delimited modes.
add_source() {
  local target="$1"
  local remote_path="$2"
  local modes="$3"

  local existing_target

  validate_target "${target}" ||
    die "Invalid source target '${target}'. Targets must be safe relative paths."
  [[ -n ${remote_path} ]] || die "Source '${target}' has an empty remote path."
  [[ ${remote_path} != *[$'\n\r']* ]] ||
    die "Source '${target}' contains an unsupported line break."
  [[ -n ${modes} ]] || die "Source '${target}' has no modes."
  validate_source_modes "${target}" "${modes}"

  for existing_target in "${SOURCE_TARGETS[@]:-}"; do
    [[ ${existing_target} != "${target}" ]] ||
      die "Source target is configured more than once: ${target}"
  done

  SOURCE_TARGETS+=("${target}")
  SOURCE_PATHS+=("${remote_path}")
  SOURCE_MODES+=("${modes}")
}

# @description Validate a source's comma-delimited mode list.
# @arg $1 string Source target for diagnostics.
# @arg $2 string Mode list.
validate_source_modes() {
  local target="$1"
  local modes="$2"
  local remaining="${modes}"
  local item=""

  if [[ ${modes} == ,* || ${modes} == *, || ${modes} == *",,"* ]]; then
    die "Source '${target}' has an empty mode."
  fi

  while true; do
    item="${remaining%%,*}"
    item="$(trim "${item}")"
    case "${item}" in
      full | images | videos | audio | documents) ;;
      *)
        die "Source '${target}' has an unsupported mode: ${item:-<empty>}"
        ;;
    esac

    [[ ${remaining} == *,* ]] || break
    remaining="${remaining#*,}"
  done
}

# @description Parse and register a TARGET=REMOTE_PATH CLI source.
# @arg $1 string Source definition.
add_cli_source() {
  local definition="$1"
  local target="${definition%%=*}"
  local remote_path=""

  if [[ ${definition} != *=* ]]; then
    die "--source must use TARGET=REMOTE_PATH."
  fi

  remote_path="${definition#*=}"
  add_source "${target}" "${remote_path}" "full"
}

# @description Register the built-in Termux shared-storage sources.
load_default_sources() {
  # Full roots deliberately do not overlap. The shared alias contains all
  # primary Android shared storage; external-1 is skipped when unavailable.
  add_source "shared" "~/storage/shared" "full"
  add_source "external-1" "~/storage/external-1" "full"

  # Category sources map into the same canonical tree produced by a full pull.
  add_source "shared/Download" "~/storage/downloads" "images,videos,audio,documents"
  add_source "shared/DCIM" "~/storage/dcim" "images,videos"
  add_source "shared/Pictures" "~/storage/pictures" "images"
  add_source "shared/Movies" "~/storage/movies" "videos"
  add_source "shared/Music" "~/storage/music" "audio"
  add_source "shared/Documents" "~/storage/shared/Documents" "documents"
  add_source "shared/Recordings" "~/storage/shared/Recordings" "audio"
  add_source "shared/Podcasts" "~/storage/shared/Podcasts" "audio"
  add_source "shared/Audiobooks" "~/storage/shared/Audiobooks" "audio"
  add_source "shared/Android/media" "~/storage/shared/Android/media" "images,videos,audio,documents"
}

# @description Load pipe-delimited source definitions from a file.
# @arg $1 string Source configuration path.
load_sources_file() {
  local file="$1"
  local line=""
  local target=""
  local remote_path=""
  local modes=""
  local extra=""
  local line_number=0

  [[ -n ${file} ]] || return 0
  [[ -e ${file} ]] || return 0
  [[ -f ${file} ]] || die "Sources file is not a regular file: ${file}"
  [[ -r ${file} ]] || die "Sources file is not readable: ${file}"

  while IFS= read -r line || [[ -n ${line} ]]; do
    line_number=$((line_number + 1))
    line="$(trim "${line}")"

    [[ -n ${line} ]] || continue
    [[ ${line} != \#* ]] || continue

    target=""
    remote_path=""
    modes=""
    extra=""
    IFS="|" read -r target remote_path modes extra <<<"${line}"

    target="$(trim "${target}")"
    remote_path="$(trim "${remote_path}")"
    modes="$(trim "${modes}")"

    if [[ -n ${extra} ]]; then
      die "Invalid source at ${file}:${line_number}: expected exactly three fields."
    fi

    add_source "${target}" "${remote_path}" "${modes}"
  done <"${file}"
}

# @description Load every enabled source layer and require a nonempty result.
load_sources() {
  if [[ ${USE_DEFAULT_SOURCES} == true ]]; then
    load_default_sources
  fi
  load_sources_file "${SOURCES_FILE}"

  if [[ ${#SOURCE_TARGETS[@]} -eq 0 ]]; then
    die "No sources are configured."
  fi
}

# @description Return success when a mode list contains an exact value.
# @arg $1 string Comma-delimited mode list.
# @arg $2 string Expected mode.
mode_list_contains() {
  local list="$1"
  local expected="$2"
  local remaining="${list}"
  local item=""

  while true; do
    item="${remaining%%,*}"
    item="$(trim "${item}")"
    if [[ ${item} == "${expected}" ]]; then
      return 0
    fi

    [[ ${remaining} == *,* ]] || break
    remaining="${remaining#*,}"
  done
  return 1
}

# @description Return success when a source participates in the selected mode.
# @arg $1 string Source mode list.
source_is_selected() {
  local modes="$1"

  if [[ ${MODE} == "full" ]]; then
    mode_list_contains "${modes}" "full"
    return
  fi

  if [[ ${SELECT_IMAGES} == true ]] && mode_list_contains "${modes}" "images"; then
    return 0
  fi
  if [[ ${SELECT_VIDEOS} == true ]] && mode_list_contains "${modes}" "videos"; then
    return 0
  fi
  if [[ ${SELECT_AUDIO} == true ]] && mode_list_contains "${modes}" "audio"; then
    return 0
  fi
  if [[ ${SELECT_DOCUMENTS} == true ]] && mode_list_contains "${modes}" "documents"; then
    return 0
  fi
  return 1
}

# @description Print the effective source configuration as a table.
print_sources() {
  local index=0

  printf "%-28s %-48s %s\n" "TARGET" "REMOTE PATH" "MODES"
  printf "%-28s %-48s %s\n" "------" "-----------" "-----"

  while ((index < ${#SOURCE_TARGETS[@]})); do
    printf "%-28s %-48s %s\n" \
      "${SOURCE_TARGETS[${index}]}" \
      "${SOURCE_PATHS[${index}]}" \
      "${SOURCE_MODES[${index}]}"
    index=$((index + 1))
  done
}

# ------------------------------------------------------------------------------
# SSH and environment
# ------------------------------------------------------------------------------

# @description Build the normalized SSH argument array.
build_ssh_args() {
  SSH_ARGS=(
    -o "ConnectTimeout=${CONNECT_TIMEOUT}"
  )

  if [[ ${NON_INTERACTIVE} == true ]]; then
    SSH_ARGS+=(-o "BatchMode=yes")
  fi
  if [[ -n ${SSH_PORT} ]]; then
    SSH_ARGS+=(-p "${SSH_PORT}")
  fi
  if [[ -n ${SSH_IDENTITY_FILE} ]]; then
    SSH_ARGS+=(-i "${SSH_IDENTITY_FILE}")
  fi
}

# @description Quote one value for safe evaluation by the remote POSIX shell.
# @arg $1 string Untrusted value.
# @stdout Single-quoted shell word.
shell_quote() {
  local value="$1"
  value="${value//\'/\'\\\'\'}"
  printf "'%s'" "${value}"
}

# @description Print the shell-quoted rsync remote-shell command.
# @stdout Remote-shell command string.
build_rsync_rsh() {
  local command="ssh"
  local argument=""

  for argument in "${SSH_ARGS[@]}"; do
    command+=" $(shell_quote "${argument}")"
  done
  printf "%s" "${command}"
}

# @description Require all local transfer dependencies.
validate_local_environment() {
  local command=""
  for command in ssh rsync mkdir date; do
    command -v "${command}" >/dev/null 2>&1 ||
      die "Required command not found: ${command}"
  done
}

# @description Verify SSH connectivity to the configured phone host.
validate_connection() {
  log_info "Connecting to ${REMOTE_HOST}..."
  if ! ssh "${SSH_ARGS[@]}" "${REMOTE_HOST}" "true"; then
    die "Could not connect to '${REMOTE_HOST}'. Check SSH access or run '${PROGRAM_NAME} doctor'."
  fi
  log_success "SSH connection validated."
}

# @description Verify that rsync is installed on the remote Termux host.
validate_remote_rsync() {
  if ! ssh "${SSH_ARGS[@]}" "${REMOTE_HOST}" "command -v rsync >/dev/null 2>&1"; then
    die "rsync is not installed on '${REMOTE_HOST}'. In Termux, run: pkg install rsync"
  fi
}

# @description Resolve and validate the remote Termux home directory.
# @stdout Absolute remote home path.
resolve_remote_home() {
  local remote_home=""
  remote_home="$(ssh "${SSH_ARGS[@]}" "${REMOTE_HOST}" 'printf "%s" "$HOME"')" ||
    die "Could not resolve the remote home directory."

  [[ -n ${remote_home} && ${remote_home} == /* ]] ||
    die "The remote home directory is invalid."
  [[ ${remote_home} != *[$'\n\r']* ]] ||
    die "The remote home directory contains an unsupported line break."
  printf "%s" "${remote_home}"
}

# @description Expand a configured source path against the remote home.
# @arg $1 string Configured remote path.
# @arg $2 string Absolute remote home.
# @stdout Absolute remote path.
expand_remote_path() {
  local path="$1"
  local remote_home="$2"

  case "${path}" in
    "~")
      printf "%s" "${remote_home}"
      ;;
    \~/*)
      printf "%s/%s" "${remote_home}" "${path:2}"
      ;;
    /*)
      printf "%s" "${path}"
      ;;
    *)
      printf "%s/%s" "${remote_home}" "${path}"
      ;;
  esac
}

# @description Return success when an exact remote directory exists.
# @arg $1 string Absolute remote path.
remote_directory_exists() {
  local remote_path="$1"
  local quoted_path=""
  quoted_path="$(shell_quote "${remote_path}")"
  # shellcheck disable=SC2029 # quoted_path is intentionally shell-quoted for the remote shell.
  ssh "${SSH_ARGS[@]}" "${REMOTE_HOST}" "test -d ${quoted_path}" >/dev/null 2>&1
}

# ------------------------------------------------------------------------------
# Rsync filtering
# ------------------------------------------------------------------------------

readonly -a IMAGE_EXTENSIONS=(
  jpg jpeg jpe png gif webp heic heif avif bmp tif tiff svg
  dng raw cr2 cr3 nef nrw arw raf orf rw2 pef srw
)
readonly -a VIDEO_EXTENSIONS=(
  mp4 mov m4v mkv webm avi mpg mpeg 3gp 3g2 mts m2ts ts vob ogv
)
readonly -a AUDIO_EXTENSIONS=(
  wav mp3 flac ogg oga opus m4a aac alac aif aiff wma amr mid midi
)
readonly -a DOCUMENT_EXTENSIONS=(
  pdf txt text md markdown rtf
  doc docx odt pages
  xls xlsx ods numbers
  ppt pptx odp key
  csv tsv json jsonl ndjson yaml yml toml xml
  epub mobi azw azw3
  zip 7z rar tar tgz gz bz2 xz zst
  log ini conf cfg
)

# @description Build an rsync pattern for a case-insensitive extension.
# @arg $1 string Lowercase extension without a dot.
# @stdout Rsync include pattern.
case_insensitive_extension_pattern() {
  local extension="$1"
  local pattern=""
  local character=""
  local index=0

  while ((index < ${#extension})); do
    character="${extension:index:1}"
    case "${character}" in
      a) pattern+="[aA]" ;;
      b) pattern+="[bB]" ;;
      c) pattern+="[cC]" ;;
      d) pattern+="[dD]" ;;
      e) pattern+="[eE]" ;;
      f) pattern+="[fF]" ;;
      g) pattern+="[gG]" ;;
      h) pattern+="[hH]" ;;
      i) pattern+="[iI]" ;;
      j) pattern+="[jJ]" ;;
      k) pattern+="[kK]" ;;
      l) pattern+="[lL]" ;;
      m) pattern+="[mM]" ;;
      n) pattern+="[nN]" ;;
      o) pattern+="[oO]" ;;
      p) pattern+="[pP]" ;;
      q) pattern+="[qQ]" ;;
      r) pattern+="[rR]" ;;
      s) pattern+="[sS]" ;;
      t) pattern+="[tT]" ;;
      u) pattern+="[uU]" ;;
      v) pattern+="[vV]" ;;
      w) pattern+="[wW]" ;;
      x) pattern+="[xX]" ;;
      y) pattern+="[yY]" ;;
      z) pattern+="[zZ]" ;;
      *) pattern+="${character}" ;;
    esac
    index=$((index + 1))
  done

  printf "*.%s" "${pattern}"
}

# @description Append case-insensitive extension includes to rsync arguments.
# @arg $@ string File extensions.
add_extension_includes() {
  local extension=""

  for extension in "$@"; do
    RSYNC_ARGS+=("--include=$(case_insensitive_extension_pattern "${extension}")")
  done
}

# @description Build the complete deterministic rsync argument array.
build_rsync_args() {
  local rsync_rsh=""
  local exclude=""
  local show_progress=false

  rsync_rsh="$(build_rsync_rsh)"

  RSYNC_ARGS=(
    --archive
    --no-owner
    --no-group
    --no-perms
    --human-readable
    --stats
    --partial
    --partial-dir=".phone-harvest-partial"
    --rsh="${rsync_rsh}"
  )

  case "${ENABLE_PROGRESS}" in
    always) show_progress=true ;;
    auto)
      if [[ -t 1 ]]; then
        show_progress=true
      fi
      ;;
  esac

  if [[ ${show_progress} == true ]]; then
    RSYNC_ARGS+=(--progress)
  fi
  if [[ ${DRY_RUN} == true ]]; then
    RSYNC_ARGS+=(--dry-run)
  fi
  if [[ ${TRANSFER_MODE} == "move" ]]; then
    RSYNC_ARGS+=(--remove-source-files)
  fi
  if [[ ${CHECKSUM_MODE} == "always" ||
    (${CHECKSUM_MODE} == "auto" && ${TRANSFER_MODE} == "move") ]]; then
    RSYNC_ARGS+=(--checksum)
  fi

  # Preserve any replaced local file in a run-specific backup directory.
  RSYNC_ARGS+=(
    --backup
    "--backup-dir=${DESTINATION_ROOT}/.phone-harvest/backups/${RUN_ID}"
  )

  # Modern Android normally blocks Termux from these app-private trees. Avoid
  # turning an otherwise successful shared-storage archive into rsync code 23.
  if [[ ${INCLUDE_RESTRICTED_ANDROID_PATHS} == false ]]; then
    RSYNC_ARGS+=(
      --exclude="/Android/data/***"
      --exclude="/Android/obb/***"
    )
  fi

  for exclude in "${EXTRA_EXCLUDES[@]}"; do
    RSYNC_ARGS+=("--exclude=${exclude}")
  done

  if [[ ${MODE} == "categories" ]]; then
    RSYNC_ARGS+=(--prune-empty-dirs)
    RSYNC_ARGS+=(--include="*/")
    if [[ ${SELECT_IMAGES} == true ]]; then
      add_extension_includes "${IMAGE_EXTENSIONS[@]}"
    fi
    if [[ ${SELECT_VIDEOS} == true ]]; then
      add_extension_includes "${VIDEO_EXTENSIONS[@]}"
    fi
    if [[ ${SELECT_AUDIO} == true ]]; then
      add_extension_includes "${AUDIO_EXTENSIONS[@]}"
    fi
    if [[ ${SELECT_DOCUMENTS} == true ]]; then
      add_extension_includes "${DOCUMENT_EXTENSIONS[@]}"
    fi
    RSYNC_ARGS+=(--exclude="*")
  fi
}

# ------------------------------------------------------------------------------
# Transfer
# ------------------------------------------------------------------------------

# @description Require explicit confirmation before remote source deletion.
confirm_move() {
  local answer=""

  if [[ ${TRANSFER_MODE} != "move" || ${DRY_RUN} == true || ${ASSUME_YES} == true ]]; then
    return
  fi

  if [[ ${NON_INTERACTIVE} == true || ! -t 0 ]]; then
    die "--move requires --yes when input is non-interactive."
  fi

  printf "\n%sWARNING:%s --move will delete phone files after successful transfer.\n" \
    "${COLOR_BOLD}${COLOR_YELLOW}" "${COLOR_RESET}" >&2
  printf "Destination: %s\n" "${DESTINATION_ROOT}" >&2
  printf 'Type "move" to continue: ' >&2
  IFS= read -r answer
  [[ ${answer} == "move" ]] || die "Move cancelled."
}

# @description Transfer one selected remote source into its local target.
# @arg $1 string Local relative target.
# @arg $2 string Absolute remote source path.
transfer_source() {
  local target="$1"
  local remote_path="$2"
  local destination="${DESTINATION_ROOT}/${target}"
  local remote_spec=""
  local action_label="Copying"
  local rsync_status=0

  LAST_SOURCE_WAS_SKIPPED=false

  if [[ ${TRANSFER_MODE} == "move" ]]; then
    action_label="Moving"
  fi

  if ! remote_directory_exists "${remote_path}"; then
    SKIPPED_SOURCES=$((SKIPPED_SOURCES + 1))
    LAST_SOURCE_WAS_SKIPPED=true
    if [[ ${SKIP_MISSING_SOURCES} == true ]]; then
      log_warn "Skipping unavailable source: ${remote_path}"
      return 0
    fi
    log_error "Remote source is unavailable: ${remote_path}"
    FAILED_SOURCES=$((FAILED_SOURCES + 1))
    return 1
  fi

  mkdir -p "${destination}"

  # Do not embed shell quote characters in an rsync HOST:PATH argument.
  # Rsync 3.2.4+ preserves and protects remote filename arguments itself;
  # older rsync releases also expect the local shell's syntactic quotes to
  # have been removed before rsync receives the argument. Because this value
  # is already one Bash array element, spaces remain part of the same source
  # argument without adding literal quote characters.
  remote_spec="${REMOTE_HOST}:${remote_path%/}/"

  log_info "${action_label} ${remote_path} → ${destination}"
  log_debug "Source target: ${target}"

  if rsync "${RSYNC_ARGS[@]}" "${remote_spec}" "${destination}/"; then
    TRANSFERRED_SOURCES=$((TRANSFERRED_SOURCES + 1))
    log_success "Completed ${target}."
    return 0
  else
    rsync_status=$?
  fi

  if [[ ${FIRST_FAILURE_CODE} -eq 0 ]]; then
    FIRST_FAILURE_CODE="${rsync_status}"
  fi
  FAILED_SOURCES=$((FAILED_SOURCES + 1))
  log_error "Transfer failed for ${remote_path} (rsync exit ${rsync_status})."
  return "${rsync_status}"
}

# @description Remove empty subdirectories beneath one transferred remote source.
# @arg $1 string Absolute remote source path.
cleanup_remote_source() {
  local remote_path="$1"
  local quoted_path=""

  quoted_path="$(shell_quote "${remote_path}")"
  # shellcheck disable=SC2029 # quoted_path is intentionally shell-quoted for the remote shell.
  ssh "${SSH_ARGS[@]}" "${REMOTE_HOST}" \
    "find ${quoted_path} -depth -mindepth 1 -type d -empty -delete"
}

# @description Validate, transfer, optionally clean, and summarize selected sources.
harvest() {
  local remote_home=""
  local index=0
  local selected_count=0
  local run_failed=false
  local resolved_path=""
  declare -a cleanup_paths=()

  validate_local_environment
  build_ssh_args
  validate_connection
  validate_remote_rsync
  remote_home="$(resolve_remote_home)"
  build_rsync_args
  confirm_move

  mkdir -p "${DESTINATION_ROOT}"

  while ((index < ${#SOURCE_TARGETS[@]})); do
    if source_is_selected "${SOURCE_MODES[${index}]}"; then
      selected_count=$((selected_count + 1))
      resolved_path="$(expand_remote_path "${SOURCE_PATHS[${index}]}" "${remote_home}")"

      if [[ ${TRANSFER_MODE} == "move" &&
        (${resolved_path} == "/" || ${resolved_path} == "${remote_home}") ]]; then
        die "Refusing to move the remote root or Termux home: ${resolved_path}"
      fi

      if transfer_source "${SOURCE_TARGETS[${index}]}" "${resolved_path}"; then
        if [[ ${LAST_SOURCE_WAS_SKIPPED} == false &&
          ${TRANSFER_MODE} == "move" &&
          ${CLEANUP_EMPTY_DIRECTORIES} == true &&
          ${DRY_RUN} == false ]]; then
          cleanup_paths+=("${resolved_path}")
        fi
      else
        run_failed=true
      fi
    fi
    index=$((index + 1))
  done

  if ((selected_count == 0)); then
    die "No configured sources match the selected mode."
  fi

  if [[ ${TRANSFERRED_SOURCES} -eq 0 && ${SKIPPED_SOURCES} -gt 0 ]]; then
    log_error "None of the selected remote sources were available."
    run_failed=true
    FIRST_FAILURE_CODE=1
  fi

  if [[ ${run_failed} == false && ${#cleanup_paths[@]} -gt 0 ]]; then
    log_info "Removing empty phone directories..."
    for resolved_path in "${cleanup_paths[@]}"; do
      cleanup_remote_source "${resolved_path}"
    done
    log_success "Empty-directory cleanup complete."
  elif [[ ${run_failed} == true && ${CLEANUP_EMPTY_DIRECTORIES} == true ]]; then
    log_warn "Skipping empty-directory cleanup because at least one transfer failed."
  fi

  print_summary

  if [[ ${run_failed} == true ]]; then
    if [[ ${FIRST_FAILURE_CODE} -ne 0 ]]; then
      return "${FIRST_FAILURE_CODE}"
    fi
    return 1
  fi
}

# ------------------------------------------------------------------------------
# Diagnostics and summary
# ------------------------------------------------------------------------------

# @description Print the selected categories as a comma-delimited value.
# @stdout Selected categories.
print_category_selection() {
  local selected=""

  [[ ${SELECT_IMAGES} == false ]] || selected+="images,"
  [[ ${SELECT_VIDEOS} == false ]] || selected+="videos,"
  [[ ${SELECT_AUDIO} == false ]] || selected+="audio,"
  [[ ${SELECT_DOCUMENTS} == false ]] || selected+="documents,"
  selected="${selected%,}"
  printf "%s" "${selected:-none}"
}

# @description Print the final transfer summary.
print_summary() {
  local finished_at=""
  local duration=0
  local result_label="COMPLETE"
  local checksum_enabled=false

  finished_at="$(date +%s)"
  duration=$((finished_at - RUN_STARTED_AT))
  if [[ ${FAILED_SOURCES} -gt 0 ||
    (${TRANSFERRED_SOURCES} -eq 0 && ${SKIPPED_SOURCES} -gt 0) ]]; then
    result_label="FINISHED WITH ERRORS"
  fi
  if [[ ${CHECKSUM_MODE} == "always" ||
    (${CHECKSUM_MODE} == "auto" && ${TRANSFER_MODE} == "move") ]]; then
    checksum_enabled=true
  fi

  printf "\n%s════════════════════════════════════════════════════%s\n" \
    "${COLOR_BOLD}" "${COLOR_RESET}"
  printf "%s📱 PHONE HARVEST %s%s\n" "${COLOR_BOLD}" "${result_label}" "${COLOR_RESET}"
  printf "%s════════════════════════════════════════════════════%s\n" \
    "${COLOR_BOLD}" "${COLOR_RESET}"
  printf "Host:          %s\n" "${REMOTE_HOST}"
  printf "Destination:   %s\n" "${DESTINATION_ROOT}"
  printf "Mode:          %s\n" "${MODE}"
  if [[ ${MODE} == "categories" ]]; then
    printf "Categories:    %s\n" "$(print_category_selection)"
  fi
  printf "Transfer:      %s\n" "${TRANSFER_MODE}"
  printf "Checksum:      %s\n" "${checksum_enabled}"
  printf "Dry run:       %s\n" "${DRY_RUN}"
  printf "Sources done:  %s\n" "${TRANSFERRED_SOURCES}"
  printf "Sources skip:  %s\n" "${SKIPPED_SOURCES}"
  printf "Sources fail:  %s\n" "${FAILED_SOURCES}"
  printf "Duration:      %ss\n" "${duration}"
  printf "%s════════════════════════════════════════════════════%s\n" \
    "${COLOR_BOLD}" "${COLOR_RESET}"
}

# @description Diagnose local dependencies, SSH, remote rsync, and sources.
doctor() {
  local failures=0
  local remote_home=""
  local resolved_path=""
  local index=0

  printf "%s %s doctor\n\n" "${PROGRAM_NAME}" "${PROGRAM_VERSION}"

  for command_name in ssh rsync mkdir date; do
    if command -v "${command_name}" >/dev/null 2>&1; then
      log_success "Local ${command_name}: $(command -v "${command_name}")"
    else
      log_error "Local ${command_name}: missing"
      failures=$((failures + 1))
    fi
  done

  if ((failures > 0)); then
    return 1
  fi

  build_ssh_args
  if ssh "${SSH_ARGS[@]}" "${REMOTE_HOST}" "true" >/dev/null 2>&1; then
    log_success "SSH connection: ${REMOTE_HOST}"
  else
    log_error "SSH connection failed: ${REMOTE_HOST}"
    return 1
  fi

  if ssh "${SSH_ARGS[@]}" "${REMOTE_HOST}" "command -v rsync >/dev/null 2>&1"; then
    log_success "Remote rsync: installed"
  else
    log_error "Remote rsync: missing (install with 'pkg install rsync')"
    failures=$((failures + 1))
  fi

  remote_home="$(resolve_remote_home)"
  log_success "Remote home: ${remote_home}"

  while ((index < ${#SOURCE_TARGETS[@]})); do
    resolved_path="$(expand_remote_path "${SOURCE_PATHS[${index}]}" "${remote_home}")"
    if remote_directory_exists "${resolved_path}"; then
      log_success "Source ${SOURCE_TARGETS[${index}]}: ${resolved_path}"
    else
      log_warn "Source ${SOURCE_TARGETS[${index}]}: unavailable (${resolved_path})"
    fi
    index=$((index + 1))
  done

  if [[ -d ${DESTINATION_ROOT} && -w ${DESTINATION_ROOT} ]]; then
    log_success "Destination: writable (${DESTINATION_ROOT})"
  elif [[ ! -e ${DESTINATION_ROOT} && -w "$(dirname "${DESTINATION_ROOT}")" ]]; then
    log_success "Destination parent: writable ($(dirname "${DESTINATION_ROOT}"))"
  else
    log_error "Destination is not writable: ${DESTINATION_ROOT}"
    failures=$((failures + 1))
  fi

  if ((failures > 0)); then
    return 1
  fi

  printf "\n"
  log_success "Ready to harvest."
}

# ------------------------------------------------------------------------------
# Main
# ------------------------------------------------------------------------------

# @description Run the phone-harvest command-line application.
# @arg $@ string CLI arguments.
main() {
  parse_args "$@"
  validate_options
  configure_output
  load_sources

  case "${COMMAND}" in
    harvest)
      harvest
      ;;
    doctor)
      doctor
      ;;
    sources)
      print_sources
      ;;
  esac
}

main "$@"
