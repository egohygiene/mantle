#!/usr/bin/env bash
# shellcheck shell=bash

set -euo pipefail

readonly PROGRAM_NAME="extract-frames"
readonly VERSION="2.0.0"
readonly DEFAULT_OUTPUT_DIRECTORY=".frames"
readonly DEFAULT_FRAME_COUNT="10"
readonly MAXIMUM_SAMPLE_COUNT="1000"

INPUT_FILE=""
OUTPUT_DIRECTORY=$DEFAULT_OUTPUT_DIRECTORY
REQUESTED_FRAME_COUNT=$DEFAULT_FRAME_COUNT
STREAM_INDEX="0"
SAMPLE_ALL=false
FRAMES_OPTION_SET=false
FORCE=false
DRY_RUN=false
QUIET=false

SOURCE_FRAME_COUNT=""
EFFECTIVE_FRAME_COUNT=""
FRAME_NUMBER_PADDING="3"
SELECT_EXPRESSION=""
STAGING_DIRECTORY=""
BACKUP_PATH=""

declare -a POSITIONAL_ARGUMENTS=()
declare -a SELECTED_FRAME_INDICES=()
declare -a FFMPEG_COMMAND=()

# @description Print command usage, behavior, examples, and exit codes.
# @stdout Complete help text.
print_help() {
  printf '%s\n' "Usage: ${PROGRAM_NAME} [OPTIONS] VIDEO

Extract representative PNG frames from a video. By default, the command writes
10 distinct samples: the exact first decoded frame, eight evenly spaced interior
frames, and the exact last decoded frame.

Arguments:
  VIDEO                       Source video file.

Options:
  --frames COUNT              Total representative frames, including the first
                              and last. Default: 10. Minimum: 2. Maximum: 1000.
  --all                       Extract every decoded frame instead of sampling.
  --output DIRECTORY          Destination directory. Default: ./.frames.
  --stream INDEX              Zero-based video stream index. Default: 0.
  --force                     Replace an existing destination after extraction
                              succeeds.
  --dry-run                   Probe and print the sampling plan without writing.
  --quiet                     Suppress progress and non-error messages.
  --help                      Show this help and exit.
  --version                   Show version information and exit.

Examples:
  ${PROGRAM_NAME} clip.mp4
  ${PROGRAM_NAME} --frames 16 --output clip-frames clip.mp4
  ${PROGRAM_NAME} --stream 1 --output alternate-stream-frames recording.mkv
  ${PROGRAM_NAME} --all --output every-frame animation.mov
  ${PROGRAM_NAME} --dry-run --frames 10 clip.mp4

Output:
  frame-001.png               First selected frame.
  frame-002.png ...           Evenly spaced representative frames.
  frame-010.png               Last selected frame with the default count.
  first.png                   Convenience copy of the first selected frame.
  last.png                    Convenience copy of the last selected frame.

  The numbered sequence contains the requested number of distinct samples.
  first.png and last.png are additional convenience aliases, not extra samples.
  If the source has fewer decoded frames than requested, every source frame is
  extracted once.

Behavior:
  FFprobe counts decoded frames in the selected video stream. Frame indices are
  calculated across the inclusive range from zero through the final frame, and
  FFmpeg decodes the stream once to extract those exact indices. This is uniform
  representative sampling; the selected images are not limited to codec I-frames.

  Extraction occurs in a private staging directory beside the destination. The
  completed directory is published only after its contents are validated. With
  --force, the existing destination is retained until the replacement is ready
  and is restored if publication fails.

Dependencies:
  Bash 3.2+, FFmpeg, FFprobe, and standard POSIX filesystem utilities.

Exit codes:
  0    Success.
  2    Invalid command-line usage.
  3    Invalid input or output path.
  4    Media probing or stream validation failed.
  5    FFmpeg extraction or output validation failed.
  6    Completed output could not be published.
  127  A required command is unavailable.
"
}

# @description Print an informational message unless quiet mode is enabled.
# @arg $1 string Message.
log_info() {
  [[ "$QUIET" == true ]] || printf '%s: %s\n' "$PROGRAM_NAME" "$1"
}

# @description Print a warning message unless quiet mode is enabled.
# @arg $1 string Message.
log_warning() {
  [[ "$QUIET" == true ]] || printf '%s: warning: %s\n' "$PROGRAM_NAME" "$1" >&2
}

# @description Print an error message to standard error.
# @arg $1 string Message.
log_error() {
  printf '%s: error: %s\n' "$PROGRAM_NAME" "$1" >&2
}

# @description Exit with a command-line usage error.
# @arg $1 string Explanation.
# @exitcode 2 Always.
usage_error() {
  log_error "$1"
  printf "Try '%s --help' for more information.\n" "$PROGRAM_NAME" >&2
  exit 2
}

# @description Require an option value and store it in OPTION_VALUE.
# @arg $1 string Option name.
# @arg $2 integer Remaining argument count.
# @arg $3 string|unset Candidate value.
# @exitcode 2 If the value is missing.
require_option_value() {
  if (($2 < 2)) || [[ -z "${3-}" ]]; then
    usage_error "$1 requires a value"
  fi
  OPTION_VALUE=$3
}

# @description Parse command-line options and positional arguments.
# @arg $@ string Arguments.
# @exitcode 2 For invalid usage.
parse_arguments() {
  while (($# > 0)); do
    case "$1" in
      --frames)
        require_option_value "$1" "$#" "${2-}"
        [[ "$SAMPLE_ALL" == false ]] || usage_error "--frames cannot be combined with --all"
        REQUESTED_FRAME_COUNT=$OPTION_VALUE
        FRAMES_OPTION_SET=true
        shift
        ;;
      --all)
        [[ "$FRAMES_OPTION_SET" == false ]] || usage_error "--all cannot be combined with --frames"
        SAMPLE_ALL=true
        ;;
      --output)
        require_option_value "$1" "$#" "${2-}"
        OUTPUT_DIRECTORY=$OPTION_VALUE
        shift
        ;;
      --stream)
        require_option_value "$1" "$#" "${2-}"
        STREAM_INDEX=$OPTION_VALUE
        shift
        ;;
      --force) FORCE=true ;;
      --dry-run) DRY_RUN=true ;;
      --quiet) QUIET=true ;;
      --help)
        print_help
        exit 0
        ;;
      --version)
        printf '%s %s\n' "$PROGRAM_NAME" "$VERSION"
        exit 0
        ;;
      --)
        shift
        while (($# > 0)); do
          POSITIONAL_ARGUMENTS+=("$1")
          shift
        done
        break
        ;;
      -*) usage_error "unknown option: $1" ;;
      *) POSITIONAL_ARGUMENTS+=("$1") ;;
    esac
    shift
  done
}

# @description Return whether a value is an unsigned decimal integer.
# @arg $1 string Candidate.
# @exitcode 0 If valid.
# @exitcode 1 If invalid.
is_unsigned_integer() {
  [[ "$1" =~ ^[0-9]+$ ]]
}

# @description Split a path into DIRECTORY_NAME and FILE_NAME.
# @arg $1 string Path.
split_path() {
  case "$1" in
    */*)
      DIRECTORY_NAME=${1%/*}
      FILE_NAME=${1##*/}
      [[ -n "$DIRECTORY_NAME" ]] || DIRECTORY_NAME="/"
      ;;
    *)
      DIRECTORY_NAME="."
      FILE_NAME=$1
      ;;
  esac
}

# @description Resolve a path whose parent directory already exists.
# @arg $1 string Path.
# @stdout Physical parent path joined to the original basename.
# @exitcode 1 If the parent directory cannot be entered.
resolve_path_from_existing_parent() {
  local path_basename
  local path_parent

  split_path "$1"
  path_parent=$DIRECTORY_NAME
  path_basename=$FILE_NAME
  (
    cd "$path_parent" || exit 1
    printf '%s/%s\n' "$(pwd -P)" "$path_basename"
  )
}

# @description Require an external command or exit with status 127.
# @arg $1 string Command name.
# @exitcode 127 If the command is unavailable.
require_command() {
  if ! command -v "$1" >/dev/null 2>&1; then
    log_error "required command not found: $1"
    exit 127
  fi
}

# @description Validate arguments and normalize numeric option values.
# @exitcode 2 For invalid numeric options.
# @exitcode 3 For invalid paths.
validate_arguments() {
  local resolved_input
  local resolved_output

  if ((${#POSITIONAL_ARGUMENTS[@]} != 1)); then
    usage_error "exactly one VIDEO argument is required"
  fi

  INPUT_FILE=${POSITIONAL_ARGUMENTS[0]}

  [[ -f "$INPUT_FILE" ]] || {
    log_error "input is not a regular file: $INPUT_FILE"
    exit 3
  }
  [[ -r "$INPUT_FILE" ]] || {
    log_error "input is not readable: $INPUT_FILE"
    exit 3
  }

  is_unsigned_integer "$STREAM_INDEX" || usage_error "--stream must be a nonnegative integer"
  STREAM_INDEX=$((10#$STREAM_INDEX))

  if [[ "$SAMPLE_ALL" == false ]]; then
    is_unsigned_integer "$REQUESTED_FRAME_COUNT" || usage_error "--frames must be an integer from 2 through ${MAXIMUM_SAMPLE_COUNT}"
    REQUESTED_FRAME_COUNT=$((10#$REQUESTED_FRAME_COUNT))
    if ((REQUESTED_FRAME_COUNT < 2 || REQUESTED_FRAME_COUNT > MAXIMUM_SAMPLE_COUNT)); then
      usage_error "--frames must be an integer from 2 through ${MAXIMUM_SAMPLE_COUNT}"
    fi
  fi

  while [[ "$OUTPUT_DIRECTORY" != "/" && "$OUTPUT_DIRECTORY" == */ ]]; do
    OUTPUT_DIRECTORY=${OUTPUT_DIRECTORY%/}
  done

  [[ -n "$OUTPUT_DIRECTORY" ]] || usage_error "--output cannot be empty"
  split_path "$OUTPUT_DIRECTORY"
  if [[ "$OUTPUT_DIRECTORY" == "/" || "$FILE_NAME" == "." || "$FILE_NAME" == ".." ]]; then
    log_error "refusing unsafe output directory: $OUTPUT_DIRECTORY"
    exit 3
  fi

  resolved_input=$(resolve_path_from_existing_parent "$INPUT_FILE")
  if resolved_output=$(resolve_path_from_existing_parent "$OUTPUT_DIRECTORY" 2>/dev/null); then
    if [[ "$resolved_output" == "$resolved_input" ]]; then
      log_error "output directory cannot replace the input video: $OUTPUT_DIRECTORY"
      exit 3
    fi
  fi

  if [[ "$DRY_RUN" == false && "$FORCE" == false ]] && [[ -e "$OUTPUT_DIRECTORY" || -L "$OUTPUT_DIRECTORY" ]]; then
    log_error "output already exists; choose another path or use --force: $OUTPUT_DIRECTORY"
    exit 3
  fi
}

# @description Count decoded frames in the selected video stream.
# @exitcode 4 If probing fails or returns no usable frame count.
probe_source_frame_count() {
  local probe_output

  log_info "probing video stream ${STREAM_INDEX}"
  if ! probe_output=$(ffprobe \
    -v error \
    -select_streams "v:${STREAM_INDEX}" \
    -count_frames \
    -show_entries "stream=nb_read_frames" \
    -of "default=noprint_wrappers=1:nokey=1" \
    -i "$INPUT_FILE"); then
    log_error "FFprobe could not read video stream ${STREAM_INDEX}: $INPUT_FILE"
    exit 4
  fi

  while IFS= read -r PROBED_VALUE; do
    if is_unsigned_integer "$PROBED_VALUE" && ((10#$PROBED_VALUE > 0)); then
      SOURCE_FRAME_COUNT=$((10#$PROBED_VALUE))
      break
    fi
  done <<<"$probe_output"

  if [[ -z "$SOURCE_FRAME_COUNT" ]]; then
    log_error "video stream ${STREAM_INDEX} has no countable decoded frames: $INPUT_FILE"
    exit 4
  fi
}

# @description Compute unique evenly spaced decoded-frame indices.
calculate_selected_frame_indices() {
  local denominator
  local frame_index
  local sample_index

  SELECTED_FRAME_INDICES=()

  if [[ "$SAMPLE_ALL" == true ]]; then
    EFFECTIVE_FRAME_COUNT=$SOURCE_FRAME_COUNT
    SELECTED_FRAME_INDICES=("0" "$((SOURCE_FRAME_COUNT - 1))")
    return
  fi

  if ((SOURCE_FRAME_COUNT <= REQUESTED_FRAME_COUNT)); then
    EFFECTIVE_FRAME_COUNT=$SOURCE_FRAME_COUNT
    for ((frame_index = 0; frame_index < SOURCE_FRAME_COUNT; frame_index += 1)); do
      SELECTED_FRAME_INDICES+=("$frame_index")
    done

    if ((SOURCE_FRAME_COUNT < REQUESTED_FRAME_COUNT)); then
      log_warning "requested ${REQUESTED_FRAME_COUNT} samples, but the stream contains only ${SOURCE_FRAME_COUNT}; extracting every frame once"
    fi
    return
  fi

  EFFECTIVE_FRAME_COUNT=$REQUESTED_FRAME_COUNT
  denominator=$((EFFECTIVE_FRAME_COUNT - 1))
  for ((sample_index = 0; sample_index < EFFECTIVE_FRAME_COUNT; sample_index += 1)); do
    frame_index=$(((sample_index * (SOURCE_FRAME_COUNT - 1) + denominator / 2) / denominator))
    SELECTED_FRAME_INDICES+=("$frame_index")
  done
}

# @description Calculate zero-padded output numbering width.
calculate_frame_number_padding() {
  local digits=${#EFFECTIVE_FRAME_COUNT}
  if ((digits > FRAME_NUMBER_PADDING)); then
    FRAME_NUMBER_PADDING=$digits
  fi
}

# @description Build the FFmpeg select expression for representative sampling.
build_select_expression() {
  local frame_index

  SELECT_EXPRESSION=""
  if ((EFFECTIVE_FRAME_COUNT == SOURCE_FRAME_COUNT)); then
    return
  fi

  for frame_index in "${SELECTED_FRAME_INDICES[@]}"; do
    if [[ -n "$SELECT_EXPRESSION" ]]; then
      SELECT_EXPRESSION+="+"
    fi
    SELECT_EXPRESSION+="eq(n\\,${frame_index})"
  done
}

# @description Print the probe-derived extraction plan.
# @stdout Human-readable plan.
print_plan() {
  local joined_indices
  local last_position=$((${#SELECTED_FRAME_INDICES[@]} - 1))

  printf '%s\n' "Input: $INPUT_FILE"
  printf '%s\n' "Video stream: $STREAM_INDEX"
  printf '%s\n' "Decoded source frames: $SOURCE_FRAME_COUNT"
  printf '%s\n' "Selected frames: $EFFECTIVE_FRAME_COUNT"
  printf '%s\n' "First decoded-frame index: ${SELECTED_FRAME_INDICES[0]}"
  printf '%s\n' "Last decoded-frame index: ${SELECTED_FRAME_INDICES[$last_position]}"
  printf '%s\n' "Output directory: $OUTPUT_DIRECTORY"

  if [[ "$SAMPLE_ALL" == false ]] && ((EFFECTIVE_FRAME_COUNT <= 50)); then
    joined_indices=$(IFS=,; printf '%s' "${SELECTED_FRAME_INDICES[*]}")
    printf '%s\n' "Decoded-frame indices: $joined_indices"
  elif [[ "$SAMPLE_ALL" == true ]]; then
    printf '%s\n' "Decoded-frame indices: every decoded frame"
  else
    printf '%s\n' "Decoded-frame indices: omitted from plan because the selection exceeds 50 frames"
  fi
}

# @description Create a private extraction directory beside the destination.
# @exitcode 3 If the parent or staging directory cannot be created.
create_staging_directory() {
  local destination_name
  local destination_parent

  split_path "$OUTPUT_DIRECTORY"
  destination_parent=$DIRECTORY_NAME
  destination_name=$FILE_NAME

  if ! mkdir -p "$destination_parent"; then
    log_error "could not create output parent directory: $destination_parent"
    exit 3
  fi
  if ! STAGING_DIRECTORY=$(mktemp -d "${destination_parent}/.${destination_name}.tmp.XXXXXX"); then
    log_error "could not create a private staging directory beside: $OUTPUT_DIRECTORY"
    exit 3
  fi
}

# @description Build the FFmpeg extraction command.
build_ffmpeg_command() {
  local log_level="warning"
  local stats_option="-stats"
  local output_pattern

  if [[ "$QUIET" == true ]]; then
    log_level="error"
    stats_option="-nostats"
  fi

  output_pattern="${STAGING_DIRECTORY}/frame-%0${FRAME_NUMBER_PADDING}d.png"
  FFMPEG_COMMAND=(
    ffmpeg
    -hide_banner
    -loglevel "$log_level"
    "$stats_option"
    -nostdin
    -i "$INPUT_FILE"
    -map "0:v:${STREAM_INDEX}"
    -an
    -sn
    -dn
  )

  if [[ -n "$SELECT_EXPRESSION" ]]; then
    FFMPEG_COMMAND+=(
      -vf "select=${SELECT_EXPRESSION}"
    )
  fi

  FFMPEG_COMMAND+=(
    -frames:v "$EFFECTIVE_FRAME_COUNT"
    -fps_mode passthrough
    -start_number 1
    -compression_level 6
    -y
    "$output_pattern"
  )
}

# @description Extract frames into the private staging directory.
# @exitcode 5 If FFmpeg fails.
extract_frames() {
  log_info "extracting ${EFFECTIVE_FRAME_COUNT} frame(s) from ${SOURCE_FRAME_COUNT} decoded frame(s)"
  if ! "${FFMPEG_COMMAND[@]}"; then
    log_error "FFmpeg frame extraction failed"
    exit 5
  fi
}

# @description Validate numbered output and create endpoint aliases.
# @exitcode 5 If output is incomplete or aliases cannot be created.
validate_and_create_aliases() {
  local first_numbered_frame
  local last_numbered_frame
  local -a numbered_frames

  numbered_frames=("$STAGING_DIRECTORY"/frame-*.png)
  if [[ ! -e "${numbered_frames[0]}" ]] || ((${#numbered_frames[@]} != EFFECTIVE_FRAME_COUNT)); then
    log_error "expected ${EFFECTIVE_FRAME_COUNT} numbered frames, but found ${#numbered_frames[@]}"
    exit 5
  fi

  first_numbered_frame=${numbered_frames[0]}
  last_numbered_frame=${numbered_frames[${#numbered_frames[@]} - 1]}
  if ! cp "$first_numbered_frame" "$STAGING_DIRECTORY/first.png"; then
    log_error "could not create first.png"
    exit 5
  fi
  if ! cp "$last_numbered_frame" "$STAGING_DIRECTORY/last.png"; then
    log_error "could not create last.png"
    exit 5
  fi
}

# @description Reserve a nonexistent sibling path for rollback publication.
# @arg $1 string Destination parent.
# @arg $2 string Destination basename.
# @stdout Reserved path.
# @exitcode 1 If a path cannot be reserved.
reserve_backup_path() {
  local reserved_path

  reserved_path=$(mktemp -d "${1}/.${2}.backup.XXXXXX") || return 1
  rmdir "$reserved_path" || return 1
  printf '%s\n' "$reserved_path"
}

# @description Publish the completed staging directory with rollback protection.
# @exitcode 6 If publication fails.
publish_output_directory() {
  local destination_name
  local destination_parent

  split_path "$OUTPUT_DIRECTORY"
  destination_parent=$DIRECTORY_NAME
  destination_name=$FILE_NAME

  if [[ -e "$OUTPUT_DIRECTORY" || -L "$OUTPUT_DIRECTORY" ]]; then
    if [[ "$FORCE" == false ]]; then
      log_error "output appeared during extraction; refusing to overwrite it: $OUTPUT_DIRECTORY"
      exit 6
    fi

    if ! BACKUP_PATH=$(reserve_backup_path "$destination_parent" "$destination_name"); then
      log_error "could not reserve a rollback path for: $OUTPUT_DIRECTORY"
      exit 6
    fi
    if ! mv "$OUTPUT_DIRECTORY" "$BACKUP_PATH"; then
      log_error "could not stage the existing output for replacement: $OUTPUT_DIRECTORY"
      exit 6
    fi
  fi

  if ! mv "$STAGING_DIRECTORY" "$OUTPUT_DIRECTORY"; then
    log_error "could not publish completed frames to: $OUTPUT_DIRECTORY"
    if [[ -n "$BACKUP_PATH" && -e "$BACKUP_PATH" ]]; then
      if mv "$BACKUP_PATH" "$OUTPUT_DIRECTORY"; then
        BACKUP_PATH=""
      else
        log_error "rollback also failed; previous output remains at: $BACKUP_PATH"
      fi
    fi
    exit 6
  fi
  STAGING_DIRECTORY=""

  if [[ -n "$BACKUP_PATH" && -e "$BACKUP_PATH" ]]; then
    if ! rm -rf "$BACKUP_PATH"; then
      log_warning "replacement succeeded, but the previous output could not be removed: $BACKUP_PATH"
    fi
    BACKUP_PATH=""
  fi
}

# @description Remove private staging data and restore a displaced output on exit.
# @arg $1 integer Original process status.
cleanup() {
  local original_status=$1

  trap - EXIT HUP INT TERM

  if [[ -n "$STAGING_DIRECTORY" && -d "$STAGING_DIRECTORY" ]]; then
    rm -rf "$STAGING_DIRECTORY" || true
  fi

  if [[ -n "$BACKUP_PATH" && -e "$BACKUP_PATH" ]]; then
    if [[ ! -e "$OUTPUT_DIRECTORY" && ! -L "$OUTPUT_DIRECTORY" ]]; then
      if ! mv "$BACKUP_PATH" "$OUTPUT_DIRECTORY"; then
        log_error "could not restore the previous output; it remains at: $BACKUP_PATH"
      fi
    else
      rm -rf "$BACKUP_PATH" || true
    fi
  fi

  exit "$original_status"
}

# @description Convert a signal into a conventional process exit status.
# @arg $1 integer Exit status.
# @exitcode $1 Always.
handle_signal() {
  exit "$1"
}

# @description Run the command.
# @arg $@ string Arguments.
main() {
  parse_arguments "$@"
  validate_arguments

  require_command ffprobe
  if [[ "$DRY_RUN" == false ]]; then
    require_command ffmpeg
    require_command mktemp
  fi

  probe_source_frame_count
  calculate_selected_frame_indices
  calculate_frame_number_padding
  build_select_expression

  if [[ "$DRY_RUN" == true ]]; then
    print_plan
    return 0
  fi

  create_staging_directory
  build_ffmpeg_command
  extract_frames
  validate_and_create_aliases
  publish_output_directory

  log_info "wrote ${EFFECTIVE_FRAME_COUNT} sampled frame(s), first.png, and last.png to: $OUTPUT_DIRECTORY"
}

trap 'cleanup $?' EXIT
trap 'handle_signal 129' HUP
trap 'handle_signal 130' INT
trap 'handle_signal 143' TERM

main "$@"
