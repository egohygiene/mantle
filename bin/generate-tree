#!/usr/bin/env bash
# shellcheck shell=bash

set -euo pipefail

readonly PROGRAM_NAME="generate-tree"
readonly VERSION="3.0.0"
readonly DEFAULT_OUTPUT="docs/PROJECT_STRUCTURE.md"

OUTPUT_ARGUMENT=""
OUTPUT_WAS_SET=false
WRITE_TO_STDOUT=false
STAGE_OUTPUT=false
QUIET=false

REPOSITORY_ROOT=""
OUTPUT_PATH=""
OUTPUT_RELATIVE_PATH=""
WORK_DIRECTORY=""
TRACKED_PATHS_FILE=""
TEMPORARY_OUTPUT=""

declare -a SEEN_PATHS=()

# @description Print usage, behavior, dependencies, and exit codes.
# @stdout Complete command help.
print_help() {
  printf '%s\n' "Usage: ${PROGRAM_NAME} [OPTIONS] [OUTPUT]

Generate a Markdown document containing the complete Git-tracked project tree.

Arguments:
  OUTPUT                  Optional output path. When omitted, writes
                          ${DEFAULT_OUTPUT} beneath the repository root.

Options:
  --output FILE           Explicit output path; cannot be combined with OUTPUT.
  --stdout                Write the Markdown document to standard output.
  --stage                 Stage the completed output with git after publication.
  --quiet                 Suppress non-error status messages.
  -h, --help              Show this help and exit.
  --version               Show version information and exit.

Examples:
  ${PROGRAM_NAME}
  ${PROGRAM_NAME} ./docs/tree.md
  ${PROGRAM_NAME} --output ./docs/tree.md --stage
  ${PROGRAM_NAME} --stdout

Behavior:
  The tree is always generated from the repository root, even when this command
  is invoked from a subdirectory. Paths beneath reports/ are omitted to preserve
  the prior generated-report policy. File writes use same-directory staging and
  atomic replacement. Git staging occurs only with explicit --stage.

Dependencies:
  Bash 3.2+, Git, mkdir, mktemp, mv, and rm.

Exit codes:
  0    Tree generated successfully.
  2    Invalid command-line usage.
  3    Not inside a Git worktree.
  4    Output path is unavailable or unsafe.
  5    Git inventory or document generation failed.
  6    Output publication or explicit Git staging failed.
  127  A required host command is unavailable.
"
}

# @description Print an informational message unless quiet mode is enabled.
# @arg $1 string Message.
log_info() {
  [[ "$QUIET" == true ]] || printf '%s: %s\n' "$PROGRAM_NAME" "$1" >&2
}

# @description Print an error message to standard error.
# @arg $1 string Message.
log_error() {
  printf '%s: error: %s\n' "$PROGRAM_NAME" "$1" >&2
}

# @description Exit with a command-line usage error.
# @arg $1 string Explanation.
# @exitcode 2 Always.
usage_error() {
  log_error "$1"
  printf "Try '%s --help' for more information.\n" "$PROGRAM_NAME" >&2
  exit 2
}

# @description Require a nonempty option value and store it in OPTION_VALUE.
# @arg $1 string Option name.
# @arg $2 integer Remaining argument count.
# @arg $3 string|unset Candidate value.
# @exitcode 2 If missing.
require_option_value() {
  if (($2 < 2)) || [[ -z "${3-}" ]]; then
    usage_error "$1 requires a value"
  fi
  OPTION_VALUE=$3
}

# @description Parse command-line options and the compatibility output argument.
# @arg $@ string Arguments.
# @exitcode 2 For invalid usage.
parse_arguments() {
  while (($# > 0)); do
    case "$1" in
      --output)
        require_option_value "$1" "$#" "${2-}"
        [[ "$OUTPUT_WAS_SET" != true ]] || usage_error "output may be specified only once"
        OUTPUT_ARGUMENT=$OPTION_VALUE
        OUTPUT_WAS_SET=true
        shift
        ;;
      --stdout) WRITE_TO_STDOUT=true ;;
      --stage) STAGE_OUTPUT=true ;;
      --quiet | -q) QUIET=true ;;
      --help | -h)
        print_help
        exit 0
        ;;
      --version)
        printf '%s %s\n' "$PROGRAM_NAME" "$VERSION"
        exit 0
        ;;
      --)
        shift
        while (($# > 0)); do
          [[ "$OUTPUT_WAS_SET" != true ]] || usage_error "output may be specified only once"
          OUTPUT_ARGUMENT=$1
          OUTPUT_WAS_SET=true
          shift
        done
        break
        ;;
      -*) usage_error "unknown option: $1" ;;
      *)
        [[ "$OUTPUT_WAS_SET" != true ]] || usage_error "output may be specified only once"
        OUTPUT_ARGUMENT=$1
        OUTPUT_WAS_SET=true
        ;;
    esac
    shift
  done

  if [[ "$WRITE_TO_STDOUT" == true && "$OUTPUT_WAS_SET" == true ]]; then
    usage_error "--stdout cannot be combined with an output path"
  fi
  if [[ "$WRITE_TO_STDOUT" == true && "$STAGE_OUTPUT" == true ]]; then
    usage_error "--stage cannot be combined with --stdout"
  fi
}

# @description Require standard commands used by the generator.
# @exitcode 127 If unavailable.
require_dependencies() {
  local command_name
  for command_name in git mkdir mktemp mv rm; do
    if ! command -v "$command_name" >/dev/null 2>&1; then
      log_error "required command was not found on PATH: $command_name"
      exit 127
    fi
  done
}

# @description Resolve the repository root and destination path.
# @exitcode 3 If no Git worktree is active.
# @exitcode 4 If the output path cannot be resolved safely.
resolve_paths() {
  local output_parent
  local output_basename
  local absolute_parent

  REPOSITORY_ROOT=$(git rev-parse --show-toplevel 2>/dev/null) || {
    log_error "not inside a Git worktree"
    exit 3
  }
  REPOSITORY_ROOT=$(cd -P -- "$REPOSITORY_ROOT" && pwd -P)

  [[ "$WRITE_TO_STDOUT" != true ]] || return 0
  if [[ "$OUTPUT_WAS_SET" == true ]]; then
    OUTPUT_PATH=$OUTPUT_ARGUMENT
  else
    OUTPUT_PATH="${REPOSITORY_ROOT%/}/$DEFAULT_OUTPUT"
  fi
  case "$OUTPUT_PATH" in
    "" | *$'\n'* | *$'\r'*) usage_error "output paths must be nonempty and contain no line breaks" ;;
  esac
  case "$OUTPUT_PATH" in
    */*)
      output_parent=${OUTPUT_PATH%/*}
      output_basename=${OUTPUT_PATH##*/}
      [[ -n "$output_parent" ]] || output_parent=/
      ;;
    *)
      output_parent=.
      output_basename=$OUTPUT_PATH
      ;;
  esac
  [[ -n "$output_basename" ]] || {
    log_error "output path has no filename: $OUTPUT_PATH"
    exit 4
  }
  mkdir -p -- "$output_parent" || {
    log_error "could not create output parent directory: $output_parent"
    exit 4
  }
  [[ -d "$output_parent" && -w "$output_parent" ]] || {
    log_error "output parent is not a writable directory: $output_parent"
    exit 4
  }
  [[ ! -d "$OUTPUT_PATH" ]] || {
    log_error "output path is a directory: $OUTPUT_PATH"
    exit 4
  }

  absolute_parent=$(cd -P -- "$output_parent" && pwd -P) || {
    log_error "could not resolve output parent: $output_parent"
    exit 4
  }
  OUTPUT_PATH="${absolute_parent%/}/$output_basename"
  if [[ "$STAGE_OUTPUT" == true ]]; then
    case "$OUTPUT_PATH" in
      "${REPOSITORY_ROOT%/}/"*) OUTPUT_RELATIVE_PATH=${OUTPUT_PATH#"${REPOSITORY_ROOT%/}/"} ;;
      *)
        log_error "--stage requires an output path inside the Git worktree"
        exit 4
        ;;
    esac
  fi
}

# @description Create private working storage and inventory tracked paths.
# @exitcode 5 If Git inventory fails.
prepare_inventory() {
  local old_umask

  old_umask=$(umask)
  umask 077
  WORK_DIRECTORY=$(mktemp -d "${TMPDIR:-/tmp}/${PROGRAM_NAME}.XXXXXX") || {
    umask "$old_umask"
    log_error "could not create temporary working storage"
    exit 5
  }
  umask "$old_umask"
  TRACKED_PATHS_FILE="$WORK_DIRECTORY/tracked-paths"
  git -C "$REPOSITORY_ROOT" ls-files --full-name -z >"$TRACKED_PATHS_FILE" || {
    log_error "could not inventory Git-tracked paths"
    exit 5
  }
}

# @description Return whether a cumulative project path has already been emitted.
# @arg $1 string Cumulative path.
# @exitcode 0 If already seen.
# @exitcode 1 Otherwise.
path_was_seen() {
  local existing
  for existing in ${SEEN_PATHS[@]+"${SEEN_PATHS[@]}"}; do
    [[ "$existing" == "$1" ]] && return 0
  done
  return 1
}

# @description Render the indented project tree from the NUL-delimited inventory.
# @stdout Tree body without Markdown fences.
# @exitcode 5 If a tracked filename cannot be represented safely.
render_tree() {
  local tracked_path
  local remaining
  local component
  local cumulative
  local indent
  local level

  while IFS= read -r -d '' tracked_path; do
    case "$tracked_path" in
      reports/*) continue ;;
      *$'\n'* | *$'\r'*)
        log_error "tracked filenames containing line breaks cannot be represented in Markdown"
        return 5
        ;;
    esac
    remaining=$tracked_path
    cumulative=""
    level=0
    while :; do
      case "$remaining" in
        */*)
          component=${remaining%%/*}
          remaining=${remaining#*/}
          ;;
        *)
          component=$remaining
          remaining=""
          ;;
      esac
      if [[ -n "$cumulative" ]]; then
        cumulative="$cumulative/$component"
      else
        cumulative=$component
      fi
      ((level += 1))
      if ! path_was_seen "$cumulative"; then
        SEEN_PATHS+=("$cumulative")
        indent=""
        while ((${#indent} < (level - 1) * 2)); do
          indent+="  "
        done
        printf '%s%s\n' "$indent" "$component"
      fi
      [[ -n "$remaining" ]] || break
    done
  done <"$TRACKED_PATHS_FILE"
}

# @description Render the complete Markdown document.
# @stdout Generated project-structure document.
# @exitcode 5 If tree rendering fails.
render_document() {
  printf '# Project Structure\n\n'
  printf '```text\n'
  render_tree
  printf '```\n'
}

# @description Atomically write the rendered document to its destination.
# @exitcode 5 If rendering fails.
# @exitcode 6 If publication fails.
write_document() {
  local output_parent=${OUTPUT_PATH%/*}
  local output_basename=${OUTPUT_PATH##*/}

  TEMPORARY_OUTPUT=$(mktemp "${output_parent%/}/.${output_basename}.tmp.XXXXXX") || {
    log_error "could not create output staging file"
    exit 6
  }
  render_document >"$TEMPORARY_OUTPUT" || {
    log_error "document generation failed"
    exit 5
  }
  mv -f -- "$TEMPORARY_OUTPUT" "$OUTPUT_PATH" || {
    log_error "could not publish generated document: $OUTPUT_PATH"
    exit 6
  }
  TEMPORARY_OUTPUT=""
  log_info "tree written to $OUTPUT_PATH"

  if [[ "$STAGE_OUTPUT" == true ]]; then
    git -C "$REPOSITORY_ROOT" add -- "$OUTPUT_RELATIVE_PATH" || {
      log_error "could not stage generated output: $OUTPUT_RELATIVE_PATH"
      exit 6
    }
    log_info "staged $OUTPUT_RELATIVE_PATH"
  fi
}

# @description Remove temporary artifacts while preserving the original status.
cleanup() {
  local status=$?
  if [[ -n "$TEMPORARY_OUTPUT" && -f "$TEMPORARY_OUTPUT" ]]; then
    rm -f -- "$TEMPORARY_OUTPUT"
  fi
  if [[ -n "$WORK_DIRECTORY" && -d "$WORK_DIRECTORY" ]]; then
    rm -rf -- "$WORK_DIRECTORY"
  fi
  return "$status"
}

# @description Run generate-tree.
# @arg $@ string Command-line arguments.
main() {
  parse_arguments "$@"
  require_dependencies
  resolve_paths
  prepare_inventory

  trap cleanup EXIT
  trap 'exit 130' INT
  trap 'exit 143' TERM

  if [[ "$WRITE_TO_STDOUT" == true ]]; then
    render_document
  else
    write_document
  fi

  trap - EXIT INT TERM
  cleanup
  WORK_DIRECTORY=""
}

main "$@"
