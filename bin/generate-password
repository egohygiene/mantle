#!/usr/bin/env bash
# shellcheck shell=bash

set -euo pipefail

readonly PROGRAM_NAME="generate-password"
readonly VERSION="2.0.0"
readonly DEFAULT_PASSWORD_LENGTH="32"
readonly MAXIMUM_PASSWORD_LENGTH="4096"

PASSWORD_LENGTH=$DEFAULT_PASSWORD_LENGTH
COPY_TO_CLIPBOARD=false
QUIET=false
COLOR_MODE="auto"
CLIPBOARD_BACKEND=""

declare -a CLIPBOARD_COMMAND=()

# @description Print usage, output guarantees, dependencies, and exit codes.
# @stdout Complete command help.
print_help() {
	printf '%s\n' "Usage: ${PROGRAM_NAME} [OPTIONS]

Generate an exact-length cryptographically random password using OpenSSL.

Options:
  --length NUMBER          Password length from 1 to ${MAXIMUM_PASSWORD_LENGTH}.
                           Default: ${DEFAULT_PASSWORD_LENGTH}.
  --copy                   Also copy the password to the system clipboard.
  --quiet                  Suppress non-error status messages.
  --color                  Always color diagnostics.
  --no-color               Never color diagnostics.
  -h, --help               Show this help and exit.
  --version                Show version information and exit.

Examples:
  ${PROGRAM_NAME}
  ${PROGRAM_NAME} --length 64
  ${PROGRAM_NAME} --length 48 --copy

Output:
  Standard output contains only the generated password followed by one newline,
  making the command safe to use in command substitution or pipelines. Status
  and clipboard messages are written to standard error. Passwords use the
  URL-safe Base64 alphabet: A-Z, a-z, 0-9, hyphen, and underscore.

Security:
  Passwords are generated locally from OpenSSL's cryptographic random source.
  They are never accepted as command-line input, written to temporary files, or
  included in diagnostics. Clipboard contents remain available to other local
  applications until replaced by the clipboard owner or user.

Dependencies:
  Bash 3.2+, OpenSSL, and POSIX tr. --copy additionally requires pbcopy,
  wl-copy, or xclip.

Exit codes:
  0    Password generated successfully.
  2    Invalid command-line usage.
  4    OpenSSL did not produce a valid password.
  5    The requested clipboard operation failed.
  127  A required command or clipboard utility is unavailable.
"
}

# @description Return whether colored diagnostics should be emitted.
# @exitcode 0 If color is enabled.
# @exitcode 1 If color is disabled.
color_enabled() {
	case "$COLOR_MODE" in
	always) return 0 ;;
	never) return 1 ;;
	auto) [[ -t 2 && -z "${NO_COLOR:-}" && "${TERM:-}" != "dumb" ]] ;;
	esac
}

# @description Print an informational message unless quiet mode is enabled.
# @arg $1 string Message.
log_info() {
	[[ "$QUIET" == true ]] && return 0
	if color_enabled; then
		printf '\033[36m%s:\033[0m %s\n' "$PROGRAM_NAME" "$1" >&2
	else
		printf '%s: %s\n' "$PROGRAM_NAME" "$1" >&2
	fi
}

# @description Print an error message to standard error.
# @arg $1 string Message.
log_error() {
	if color_enabled; then
		printf '\033[31m%s: error:\033[0m %s\n' "$PROGRAM_NAME" "$1" >&2
	else
		printf '%s: error: %s\n' "$PROGRAM_NAME" "$1" >&2
	fi
}

# @description Exit with a command-line usage error.
# @arg $1 string Explanation.
# @exitcode 2 Always.
usage_error() {
	log_error "$1"
	printf "Try '%s --help' for more information.\n" "$PROGRAM_NAME" >&2
	exit 2
}

# @description Require a nonempty option value and store it in OPTION_VALUE.
# @arg $1 string Option name.
# @arg $2 integer Remaining argument count.
# @arg $3 string|unset Candidate value.
# @exitcode 2 If missing.
require_option_value() {
	if (($2 < 2)) || [[ -z "${3-}" ]]; then
		usage_error "$1 requires a value"
	fi
	OPTION_VALUE=$3
}

# @description Parse command-line options.
# @arg $@ string Arguments.
# @exitcode 2 For invalid usage.
parse_arguments() {
	while (($# > 0)); do
		case "$1" in
		--length)
			require_option_value "$1" "$#" "${2-}"
			PASSWORD_LENGTH=$OPTION_VALUE
			shift
			;;
		--copy) COPY_TO_CLIPBOARD=true ;;
		--quiet | -q) QUIET=true ;;
		--color) COLOR_MODE="always" ;;
		--no-color) COLOR_MODE="never" ;;
		--help | -h)
			print_help
			exit 0
			;;
		--version)
			printf '%s %s\n' "$PROGRAM_NAME" "$VERSION"
			exit 0
			;;
		--)
			shift
			(($# == 0)) || usage_error "positional arguments are not supported"
			break
			;;
		-*) usage_error "unknown option: $1" ;;
		*) usage_error "unexpected positional argument: $1" ;;
		esac
		shift
	done
}

# @description Validate and normalize the requested password length.
# @exitcode 2 If the length is outside the supported range.
validate_length() {
	[[ "$PASSWORD_LENGTH" =~ ^[0-9]+$ ]] || usage_error "--length must be a positive integer"
	((${#PASSWORD_LENGTH} <= 4)) || usage_error "--length must not exceed $MAXIMUM_PASSWORD_LENGTH"
	PASSWORD_LENGTH=$((10#$PASSWORD_LENGTH))
	if ((PASSWORD_LENGTH < 1 || PASSWORD_LENGTH > MAXIMUM_PASSWORD_LENGTH)); then
		usage_error "--length must be between 1 and $MAXIMUM_PASSWORD_LENGTH"
	fi
}

# @description Require the cryptographic and text-processing dependencies.
# @exitcode 127 If unavailable.
require_dependencies() {
	local command_name
	for command_name in openssl tr; do
		if ! command -v "$command_name" >/dev/null 2>&1; then
			log_error "required command was not found on PATH: $command_name"
			exit 127
		fi
	done
}

# @description Select the first available platform clipboard command.
# @exitcode 127 If no supported utility is installed.
select_clipboard_backend() {
	if command -v pbcopy >/dev/null 2>&1; then
		CLIPBOARD_BACKEND="pbcopy"
		CLIPBOARD_COMMAND=(pbcopy)
	elif command -v wl-copy >/dev/null 2>&1; then
		CLIPBOARD_BACKEND="wl-copy"
		CLIPBOARD_COMMAND=(wl-copy)
	elif command -v xclip >/dev/null 2>&1; then
		CLIPBOARD_BACKEND="xclip"
		CLIPBOARD_COMMAND=(xclip -selection clipboard)
	else
		log_error "--copy requires pbcopy, wl-copy, or xclip"
		exit 127
	fi
}

# @description Generate an exact-length URL-safe Base64 password.
# @stdout Generated password without a trailing newline.
# @exitcode 4 If generation fails or returns too little data.
generate_password() {
	local byte_count
	local encoded
	local password

	byte_count=$(((PASSWORD_LENGTH * 3 + 3) / 4 + 3))
	encoded=$(openssl rand -base64 "$byte_count") || {
		log_error "OpenSSL random generation failed"
		exit 4
	}
	password=$(printf '%s' "$encoded" | tr -d '\r\n=' | tr '+/' '-_') || {
		log_error "could not normalize OpenSSL output"
		exit 4
	}
	if ((${#password} < PASSWORD_LENGTH)); then
		log_error "OpenSSL returned less random data than requested"
		exit 4
	fi
	printf '%s' "${password:0:PASSWORD_LENGTH}"
}

# @description Copy a generated password without exposing it in process arguments.
# @arg $1 string Password.
# @exitcode 5 If the clipboard command fails.
copy_password() {
	if ! printf '%s' "$1" | "${CLIPBOARD_COMMAND[@]}"; then
		log_error "clipboard operation failed using $CLIPBOARD_BACKEND"
		exit 5
	fi
	log_info "copied password using $CLIPBOARD_BACKEND"
}

# @description Run generate-password.
# @arg $@ string Command-line arguments.
main() {
	local password

	parse_arguments "$@"
	validate_length
	require_dependencies
	if [[ "$COPY_TO_CLIPBOARD" == true ]]; then
		select_clipboard_backend
	fi

	password=$(generate_password)
	printf '%s\n' "$password"
	if [[ "$COPY_TO_CLIPBOARD" == true ]]; then
		copy_password "$password"
	fi
}

main "$@"
