{
  // Compatibility contract: Fastfetch 2.67.0.
  // The release-pinned schema keeps validation stable as upstream evolves.
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/2.67.0/doc/json_schema.json",

  "logo": {
    // Standalone use falls back to the native OS logo. Mantle startup supplies
    // the bundled Incompris artwork, or an explicitly configured user logo.
    "type": "auto",
    "source": "",
    "color": {
      "1": "",
      "2": "",
      "3": "",
      "4": "",
      "5": "",
      "6": "",
      "7": "",
      "8": "",
      "9": ""
    },
    "width": null,
    "height": null,
    "padding": {
      "top": 0,
      "left": 0,
      "bottom": 0,
      "right": 5
    },
    "printRemaining": true,
    "preserveAspectRatio": true,
    "recache": false,
    "position": "left",
    "chafa": {
      "fgOnly": false,
      "symbols": "block+border+space-wide-inverted"
      // canvasMode, colorSpace, and ditherMode are intentionally omitted so
      // Chafa can negotiate the active terminal's actual capabilities.
    }
  },

  "display": {
    "stat": false,
    "pipe": false,
    "showErrors": false,
    "disableLinewrap": true,
    "hideCursor": true,
    "separator": "    ",
    "color": {
      "keys": "light_magenta",
      "title": "light_magenta",
      "output": "cyan",
      "separator": "dim_white"
    },
    "brightColor": true,
    "duration": {
      "abbreviation": true,
      "spaceBeforeUnit": "default"
    },
    "size": {
      "maxPrefix": "TB",
      "binaryPrefix": "iec",
      "ndigits": 2,
      "spaceBeforeUnit": "default"
    },
    "temp": {
      "unit": "D",
      "ndigits": 1,
      "color": {
        "green": "green",
        "yellow": "light_yellow",
        "red": "light_red"
      },
      "spaceBeforeUnit": "default"
    },
    "percent": {
      "type": [
        "num",
        "bar",
        "num-color"
      ],
      "ndigits": 0,
      "color": {
        "green": "green",
        "yellow": "light_yellow",
        "red": "light_red"
      },
      "spaceBeforeUnit": "default",
      "width": 0
    },
    "bar": {
      "char": {
        "elapsed": "━",
        "total": "─"
      },
      "border": {
        "left": "╺",
        "right": "╸",
        "leftElapsed": "",
        "rightElapsed": ""
      },
      "color": {
        "elapsed": "light_magenta",
        "total": "dim_white",
        "border": "dim_white"
      },
      "width": 12
    },
    "fraction": {
      "ndigits": 2,
      "trailingZeros": "default"
    },
    "noBuffer": false,
    "key": {
      "width": 20,
      "type": "both-1",
      "paddingLeft": 0
    },
    "freq": {
      "ndigits": 2,
      "spaceBeforeUnit": "default"
    },
    "constants": []
  },

  "general": {
    "thread": true,
    "processingTimeout": 2500,
    "detectVersion": true,
    "playerName": ""
    // Platform-only general options are intentionally omitted. In particular,
    // dsForceDrm is valid on Linux but makes the same config invalid on macOS.
  },

  "modules": [
    {
      "type": "title",
      "key": " ",
      "keyIcon": "",
      "fqdn": false,
      "color": {
        "user": "light_magenta",
        "at": "dim_white",
        "host": "cyan"
      }
    },
    {
      "type": "separator",
      "string": "─",
      "outputColor": "dim_white",
      "times": 0
    },

    {
      "type": "custom",
      // Fastfetch 2.67.0 hides the key only for one space; empty uses "Custom".
      "key": " ",
      "format": "╭─ 󰃭  SESSION",
      "outputColor": "light_magenta"
    },
    {
      "type": "datetime",
      "key": "Time",
      "keyIcon": "󰃰"
    },
    {
      "type": "uptime",
      "key": "Uptime",
      "keyIcon": "󰔟"
    },
    {
      "type": "shell",
      "key": "Shell",
      "keyIcon": ""
    },
    {
      "type": "terminal",
      "key": "Terminal",
      "keyIcon": ""
    },
    {
      "type": "terminalfont",
      "key": "Term font",
      "keyIcon": ""
    },
    {
      "type": "terminalsize",
      "key": "Term size",
      "keyIcon": "󰍹"
    },
    {
      "type": "editor",
      "key": "Editor",
      "keyIcon": "󰏫"
    },
    {
      "type": "locale",
      "key": "Locale",
      "keyIcon": ""
    },

    {
      "type": "break"
    },
    {
      "type": "custom",
      "key": " ",
      "format": "├─ 󰍛  SYSTEM",
      "outputColor": "light_magenta"
    },
    {
      "type": "os",
      "key": "OS",
      "keyIcon": ""
    },
    {
      "type": "host",
      "key": "Host",
      "keyIcon": "󰌢"
    },
    {
      "type": "kernel",
      "key": "Kernel",
      "keyIcon": ""
    },
    {
      "type": "initsystem",
      "key": "Init",
      "keyIcon": "󰿄"
    },
    {
      "type": "packages",
      "key": "Packages",
      "keyIcon": "󰏖",
      "disabled": [
        "winget"
      ],
      "combined": true
    },
    {
      "type": "display",
      "key": "Display",
      "keyIcon": "󰍹",
      "compactType": "original-with-refresh-rate",
      "preciseRefreshRate": true,
      "order": null
    },
    {
      "type": "de",
      "key": "Desktop",
      "keyIcon": ""
    },
    {
      "type": "wm",
      "key": "WM",
      "keyIcon": "",
      "detectPlugin": true
    },
    {
      "type": "wmtheme",
      "key": "WM theme",
      "keyIcon": "󰉼"
    },
    {
      "type": "theme",
      "key": "Theme",
      "keyIcon": "󰉼"
    },
    {
      "type": "icons",
      "key": "Icons",
      "keyIcon": ""
    },
    {
      "type": "font",
      "key": "Font",
      "keyIcon": ""
    },
    {
      "type": "cursor",
      "key": "Cursor",
      "keyIcon": "󰆿"
    },
    {
      "type": "terminaltheme",
      "key": "Term theme",
      "keyIcon": "󰔎"
    },

    {
      "type": "break"
    },
    {
      "type": "custom",
      "key": " ",
      "format": "├─ 󰘚  HARDWARE",
      "outputColor": "light_magenta"
    },
    {
      "type": "cpu",
      "key": "CPU",
      "keyIcon": "",
      "temp": false,
      "showPeCoreCount": true,
      "tempSensor": ""
    },
    {
      "type": "cpucache",
      "key": "CPU cache",
      "keyIcon": ""
    },
    {
      "type": "cpuusage",
      "key": "CPU use",
      "keyIcon": "󰓅",
      "separate": false,
      "waitTime": 100,
      "percent": {
        "green": 50,
        "yellow": 80,
        "type": 0
      }
    },
    {
      "type": "loadavg",
      "key": "Load",
      "keyIcon": "󰓅",
      "ndigits": 2,
      "compact": true,
      "percent": {
        "green": 50,
        "yellow": 80,
        "type": 0
      }
    },
    {
      "type": "processes",
      "key": "Processes",
      "keyIcon": "󰐕"
    },
    {
      "type": "gpu",
      "key": "GPU",
      "keyIcon": "󰢮",
      "driverSpecific": false,
      "detectionMethod": "auto",
      "temp": false,
      "hideType": "none",
      "percent": {
        "green": 50,
        "yellow": 80,
        "type": 0
      }
    },
    {
      "type": "codec",
      "key": "Codecs",
      "keyIcon": "󰈫",
      "splitGPU": false,
      "useVulkan": false,
      "showType": "both"
    },
    {
      "type": "memory",
      "key": "Memory",
      "keyIcon": "",
      "percent": {
        "green": 50,
        "yellow": 80,
        "type": 0
      }
    },
    {
      "type": "physicalmemory",
      "key": "DIMMs",
      "keyIcon": "󰑭",
      "showEmptySlots": false
    },
    {
      "type": "swap",
      "key": "Swap",
      "keyIcon": "󰓡",
      "separate": false,
      "percent": {
        "green": 50,
        "yellow": 80,
        "type": 0
      }
    },
    {
      "type": "disk",
      "key": "Disk",
      "keyIcon": "",
      "showRegular": true,
      "showExternal": true,
      "showHidden": false,
      "showSubvolumes": false,
      "showReadOnly": false,
      "showUnknown": false,
      "folders": "",
      "hideFolders": "/efi:/boot:/boot/*",
      "hideFS": "",
      "useAvailable": true,
      "percent": {
        "green": 50,
        "yellow": 80,
        "type": 0
      }
    },
    {
      "type": "brightness",
      "key": "Brightness",
      "keyIcon": "󰃠",
      "ddcciSleep": 10,
      "compact": false,
      "percent": {
        "green": 100,
        "yellow": 100,
        "type": 0
      }
    },
    {
      "type": "battery",
      "key": "Battery",
      "keyIcon": "",
      "temp": false,
      "percent": {
        "green": 50,
        "yellow": 20,
        "type": 0
      }
    },
    {
      "type": "poweradapter",
      "key": "Power",
      "keyIcon": "󰚥"
    },

    {
      "type": "break"
    },
    {
      "type": "custom",
      "key": " ",
      "format": "├─ 󰖩  NETWORK",
      "outputColor": "light_magenta"
    },
    {
      "type": "localip",
      "key": "Local IP",
      "keyIcon": "󰩟",
      "showIpv4": true,
      "showIpv6": false,
      "showMac": false,
      "showLoop": false,
      "showPrefixLen": true,
      "showMtu": false,
      "showSpeed": true,
      "showFlags": false,
      "compact": false,
      "defaultRouteOnly": true,
      "showAllIps": false,
      "namePrefix": ""
    },
    {
      "type": "dns",
      "key": "DNS",
      "keyIcon": "󰇖",
      "showType": "both"
    },
    {
      "type": "wifi",
      "key": "Wi-Fi",
      "keyIcon": "󰖩"
    },

    {
      "type": "break"
    },
    {
      "type": "custom",
      "key": " ",
      "format": "├─ 󰆍  DEVELOPMENT",
      "outputColor": "light_magenta"
    },
    {
      "type": "version",
      "key": "Fastfetch",
      "keyIcon": ""
    },
    {
      "type": "command",
      "key": "Mantle",
      "keyIcon": "󰆍",
      "shell": "/bin/sh",
      "param": "-c",
      "text": "mantle fastfetch runtime",
      "useStdErr": false,
      "parallel": true,
      "splitLines": false,
      "condition": {
        "system": [
          "Linux",
          "macOS"
        ]
      }
    },
    {
      "type": "command",
      "key": "Workspace",
      "keyIcon": "󰉋",
      "shell": "/bin/sh",
      "param": "-c",
      "text": "mantle fastfetch workspace",
      "useStdErr": false,
      "parallel": true,
      "splitLines": false,
      "condition": {
        "system": [
          "Linux",
          "macOS"
        ]
      }
    },
    {
      "type": "command",
      "key": "Toolchains",
      "keyIcon": "󰆍",
      "shell": "/bin/sh",
      "param": "-c",
      "text": "mantle fastfetch toolchains",
      "useStdErr": false,
      "parallel": true,
      "splitLines": false,
      "condition": {
        "system": [
          "Linux",
          "macOS"
        ]
      }
    },
    {
      "type": "command",
      "key": "Contexts",
      "keyIcon": "󰡨",
      "shell": "/bin/sh",
      "param": "-c",
      "text": "mantle fastfetch contexts",
      "useStdErr": false,
      "parallel": true,
      "splitLines": false,
      "condition": {
        "system": [
          "Linux",
          "macOS"
        ]
      }
    },

    {
      "type": "break"
    },
    {
      "type": "custom",
      "key": " ",
      "format": "╰─ 󰎆  NOW PLAYING",
      "outputColor": "light_magenta"
    },
    {
      "type": "media",
      "key": "Media",
      "keyIcon": "󰝚",
      "percent": {
        "green": 100,
        "yellow": 100,
        "type": 0
      }
    },
    {
      "type": "player",
      "key": "Player",
      "keyIcon": "󰐊"
    },

    {
      "type": "break"
    },
    {
      "type": "colors",
      "key": " ",
      "keyIcon": "",
      "symbol": "block",
      "paddingLeft": 0,
      "block": {
        "width": 3,
        "range": [
          0,
          15
        ]
      },
      "brightness": "default"
    }
  ]
}
